@{
    Layout = "_Layout1";
    ViewData["Title"] = "Orders";
}


@section Styles
{
    <!-- =======================================================
         DATATABLES
    ======================================================== -->

    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">


    <!-- =======================================================
         SELECT2
    ======================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />


    <!-- =======================================================
         CUSTOM DATATABLE CSS
    ======================================================== -->

    <link rel="stylesheet"
          href="~/sneat/assets/css/custom-datatables.css">
}


<br />
<br />


<!-- =======================================================
     ADMIN MENU
======================================================= -->

<div class="container-fluid px-2">

    <div class="row g-3 justify-content-center align-items-center">


        <!-- HOME -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item home h-100"
               asp-area="Admin"
               asp-controller="Home"
               asp-action="Index">

                <i class="bx bx-home-alt"></i>

                <span>Home</span>

            </a>

        </div>


        <!-- CATEGORY -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item category h-100"
               asp-area="Admin"
               asp-controller="Category"
               asp-action="Index">

                <i class="bx bx-category-alt"></i>

                <span>Category</span>

            </a>

        </div>


        <!-- PRODUCT -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item product h-100"
               asp-area="Admin"
               asp-controller="Product"
               asp-action="Index">

                <i class="bx bx-box"></i>

                <span>Product</span>

            </a>

        </div>


        <!-- INVENTORY -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item inventory h-100"
               asp-area="Admin"
               asp-controller="Inventory"
               asp-action="Index">

                <i class="bx bx-archive-in"></i>

                <span>Inventory</span>

            </a>

        </div>


        <!-- ORDER -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item order h-100
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order"
                    ? "active"
                    : "")"
               asp-area="Admin"
               asp-controller="Order"
               asp-action="Index">

                <i class="bx bx-cart"></i>

                <span>Order</span>

            </a>

        </div>


        <!-- CONTACT -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item contact h-100
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact"
                    ? "active"
                    : "")"
               asp-area="Admin"
               asp-controller="Contact"
               asp-action="Index">

                <i class="bx bx-message-dots"></i>

                <span>Contact Messages</span>

            </a>

        </div>


        <!-- DISCOUNT -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item user h-100"
               asp-area="Admin"
               asp-controller="Discount"
               asp-action="Index">

                <i class="bx bx-group"></i>

                <span>Discount Management</span>

            </a>

        </div>


        <!-- USER -->

        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item user h-100"
               asp-area="Admin"
               asp-controller="User"
               asp-action="Index">

                <i class="bx bx-group"></i>

                <span>Users</span>

            </a>

        </div>


    </div>

</div>


<br />


<!-- =======================================================
     ORDER TABLE
======================================================= -->

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row">

        <div class="col-12">


            <!-- ===================================================
                 RESPONSE MESSAGE
            ==================================================== -->

            <partial name="_ResponsePartial" />


            <div class="card">


                <!-- ===================================================
                     HEADER
                ==================================================== -->

                <div class="card-header border-bottom
                            d-flex justify-content-between
                            align-items-center">

                    <h5 class="card-title mb-0">

                        View Orders

                    </h5>

                </div>


                <!-- ===================================================
                     SEARCH
                ==================================================== -->

                <div class="card-body pb-0">

                    <div class="row g-3 mb-3">

                        <div class="col-md-4">

                            <label class="form-label">

                                Search

                            </label>

                            <input type="text"
                                   id="orderSearch"
                                   class="form-control"
                                   placeholder="Search name, email or phone..." />

                        </div>

                    </div>


                    <!-- =================================================
                         SEARCH BUTTONS
                    ================================================== -->

                    <div class="d-flex justify-content-end
                                gap-2 mt-1 mb-3">


                        <button id="searchButton"
                                type="button"
                                class="btn btn-primary">

                            <i class="bx bx-search me-1"></i>

                            Search

                        </button>


                        <button id="resetButton"
                                type="button"
                                class="btn btn-outline-secondary">

                            <i class="bx bx-reset me-1"></i>

                            Reset

                        </button>

                    </div>

                </div>


                <!-- ===================================================
                     TABLE
                ==================================================== -->

                <div class="card-body table-responsive pt-0">

                    <table id="ordersTable"
                           class="table table-bordered
                                  table-hover w-100">

                        <thead>

                            <tr>

                                <th>
                                    Order ID
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Subtotal
                                </th>

                                <th>
                                    Discount
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Created At
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{

    <!-- =======================================================
         DATATABLES
    ======================================================== -->

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>


    <!-- =======================================================
         DATATABLE BUTTONS
    ======================================================== -->

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>


    <!-- =======================================================
         EXCEL / PDF
    ======================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>


    <!-- =======================================================
         SELECT2
    ======================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


    <script>

        $(function () {


            // =====================================================
            // DATATABLE
            // =====================================================

            let table = $("#ordersTable").DataTable({

                processing: true,

                serverSide: true,

                responsive: true,

                searching: false,

                autoWidth: true,

                pagingType: "simple_numbers",

              
                // =================================================
                // AJAX
                // =================================================

                ajax: {

                    url: "/Admin/Order/GetPagedOrders",

                    type: "POST",

                    contentType: "application/json",

                    dataType: "json",


                    data: function (d) {


                        // =========================================
                        // CUSTOM SEARCH
                        // =========================================

                        d.search.value =
                            $("#orderSearch").val();


                        return JSON.stringify(d);

                    }

                },


                // =================================================
                // COLUMNS
                // =================================================

                columns: [

                    // ---------------------------------------------
                    // ORDER ID
                    // ---------------------------------------------

                    {
                        data: 0,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // CUSTOMER
                    // ---------------------------------------------

                    {
                        data: 1,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // EMAIL
                    // ---------------------------------------------

                    {
                        data: 2,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // PHONE
                    // ---------------------------------------------

                    {
                        data: 3,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // SUBTOTAL
                    // ---------------------------------------------

                    {
                        data: 4,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // DISCOUNT
                    // ---------------------------------------------

                    {
                        data: 5,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // TOTAL
                    // ---------------------------------------------

                    {
                        data: 6,

                        orderable: true
                    },


                    // ---------------------------------------------
                    // CREATED AT
                    // ---------------------------------------------

                    {
                        data: 7,

                        orderable: false
                    },


                    // ---------------------------------------------
                    // ACTION
                    // ---------------------------------------------

                    {
                        data: 8,

                        orderable: false,

                        searchable: false,


                        render: function (data) {

                            return `
                                <a
                                    href="/Admin/Order/Details/${data}"
                                    class="btn btn-sm btn-primary">

                                    <i class="bx bx-show me-1"></i>

                                    Details

                                </a>
                            `;

                        }

                    }

                ]

            });


            // =====================================================
            // SEARCH BUTTON
            // =====================================================

            $("#searchButton").click(function () {

                table.ajax.reload(null, false);

            });


            // =====================================================
            // ENTER KEY SEARCH
            // =====================================================

            $("#orderSearch").keypress(function (e) {

                if (e.which === 13) {

                    table.ajax.reload(null, false);

                }

            });


            // =====================================================
            // RESET BUTTON
            // =====================================================

            $("#resetButton").click(function () {

                $("#orderSearch").val("");

                table.ajax.reload(null, false);

            });


        });

    </script>

}