
@using MaleFashion.Web.Areas.Admin.Models
@using MaleFashion.Infrastructure.Extensions
@using MaleFashion.Web.Codes

@model ProductModel

@{
    Layout = "_Layout1";
    ViewData["Title"] = "Create Product";
}

@{
    var response =
        TempData.Get<ResponseModel>(
            Constants.ResponseTempKey);
}


@if (response != null)
{
    <div class="alert alert-@(response.Type == ResponseTypes.Success ? "success" : "danger") alert-dismissible fade show"
         role="alert">

        @response.Message

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row justify-content-center">

        <div class="col-12">

            <div class="card">

                <!-- ================================= -->
                <!-- HEADER -->
                <!-- ================================= -->

                <div class="card-header">

                    <h4 class="mb-0">
                        Create Product
                    </h4>

                </div>


                <!-- ================================= -->
                <!-- BODY -->
                <!-- ================================= -->

                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Product"
                          asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <!-- ================================= -->
                        <!-- VALIDATION -->
                        <!-- ================================= -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ================================= -->
                        <!-- PRODUCT INFORMATION -->
                        <!-- ================================= -->

                        <h5 class="mb-3">
                            Product Information
                        </h5>


                        <div class="row">

                            <!-- Product Name -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="ProductName"
                                       class="form-label">
                                    Product Name
                                </label>

                                <input asp-for="ProductName"
                                       class="form-control"
                                       placeholder="Enter product name" />

                                <span asp-validation-for="ProductName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Branding -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Branding"
                                       class="form-label">
                                    Brand
                                </label>

                                <input asp-for="Branding"
                                       class="form-control"
                                       placeholder="Enter brand" />

                                <span asp-validation-for="Branding"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Category -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Product Price -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="ProductPrize"
                                       class="form-label">
                                    Price
                                </label>

                                <input asp-for="ProductPrize"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       placeholder="Enter product price" />

                                <span asp-validation-for="ProductPrize"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Tags -->
                            <div class="col-md-12 mb-3">

                                <label asp-for="TagsText"
                                       class="form-label">
                                    Tags
                                </label>

                                <input asp-for="TagsText"
                                       class="form-control"
                                       placeholder="men, shirt, cotton, summer" />

                                <small class="text-muted">
                                    Separate multiple tags using commas.
                                </small>

                            </div>


                            <!-- Description -->
                            <div class="col-md-12 mb-3">

                                <label asp-for="Description"
                                       class="form-label">
                                    Description
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter product description">
                                </textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Customer Preview -->
                            <div class="col-md-12 mb-3">

                                <label asp-for="CustomerPreview"
                                       class="form-label">
                                    Customer Preview
                                </label>

                                <textarea asp-for="CustomerPreview"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter customer preview">
                                </textarea>

                                <span asp-validation-for="CustomerPreview"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Additional Information -->
                            <div class="col-md-12 mb-3">

                                <label asp-for="AdditionalInfo"
                                       class="form-label">
                                    Additional Information
                                </label>

                                <textarea asp-for="AdditionalInfo"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter additional information">
                                </textarea>

                                <span asp-validation-for="AdditionalInfo"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Is Active -->
                            <div class="col-md-12 mb-4">

                                <div class="form-check">

                                    <input asp-for="IsActive"
                                           class="form-check-input" />

                                    <label asp-for="IsActive"
                                           class="form-check-label">
                                        Active
                                    </label>

                                </div>

                                <small class="text-muted">
                                    Active products can be displayed to customers.
                                </small>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- ================================= -->
                        <!-- PRODUCT VARIANTS -->
                        <!-- ================================= -->

                        <div class="d-flex justify-content-between
                            align-items-center mb-3">

                            <div>

                                <h5 class="mb-1">
                                    Product Variants
                                </h5>

                                <small class="text-muted">
                                    Add different sizes, colors and SKUs.
                                </small>

                            </div>


                            <button type="button"
                                    id="addVariant"
                                    class="btn btn-success">

                                <i class="bx bx-plus me-1"></i>
                                Add Variant

                            </button>

                        </div>


                        <!-- Variants Container -->

                        <div id="variantsContainer">
                        </div>


                        <!-- ================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================= -->

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bx bx-save me-1"></i>
                                Save Product

                            </button>


                            <a asp-area="Admin"
                               asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bx bx-arrow-back me-1"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        let variantIndex = 0;


        // ==========================================
        // ADD VARIANT
        // ==========================================

        function addVariant() {

            const index = variantIndex++;


            const html = `
                        <div class="card border mb-4 variant-card"
                             data-index="${index}">

                            <div class="card-header
                                        d-flex
                                        justify-content-between
                                        align-items-center">

                                <strong>
                                    <i class="bx bx-package me-1"></i>
                                    Variant
                                </strong>

                                <button type="button"
                                        class="btn btn-sm btn-danger remove-variant">

                                    <i class="bx bx-trash me-1"></i>
                                    Remove Variant

                                </button>

                            </div>


                            <div class="card-body">

                                <!-- ============================= -->
                                <!-- VARIANT INFORMATION -->
                                <!-- ============================= -->

                                <div class="row">

                                    <!-- SKU -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            SKU
                                        </label>

                                        <input type="text"
                                               name="Variants[${index}].Sku"
                                               class="form-control"
                                               placeholder="Enter SKU"
                                               required />

                                    </div>


                                    <!-- Size -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Size
                                        </label>

                                        <input type="text"
                                               name="Variants[${index}].Size"
                                               class="form-control"
                                               placeholder="e.g. M, L, XL"
                                               required />

                                    </div>


                                    <!-- Color -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Color
                                        </label>

                                        <input type="text"
                                               name="Variants[${index}].Color"
                                               class="form-control"
                                               placeholder="e.g. Black"
                                               required />

                                    </div>


                                    <!-- Active -->

                                    <div class="col-md-12 mb-3">

                                        <div class="form-check">

                                            <input type="checkbox"
                                                   name="Variants[${index}].IsActive"
                                                   value="true"
                                                   class="form-check-input"
                                                   checked />

                                            <label class="form-check-label">
                                                Active
                                            </label>

                                        </div>

                                    </div>

                                </div>


                                <hr />


                                <!-- ============================= -->
                                <!-- IMAGES HEADER -->
                                <!-- ============================= -->

                                <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-3">

                                    <div>

                                        <h6 class="mb-1">
                                            Product Images
                                        </h6>

                                        <small class="text-muted">
                                            Upload images for this variant.
                                        </small>

                                    </div>


                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary add-image">

                                        <i class="bx bx-plus me-1"></i>
                                        Add Image

                                    </button>

                                </div>


                                <!-- Images -->

                                <div class="images-container">

                                </div>

                            </div>

                        </div>
                    `;


            $("#variantsContainer")
                .append(html);


            addImage(
                $(`.variant-card[data-index="${index}"]`)
            );
        }


        // ==========================================
        // ADD IMAGE
        // ==========================================

        function addImage(variantCard) {

            const variantIndex =
                variantCard.data("index");


            const imageContainer =
                variantCard.find(
                    ".images-container"
                );


            const imageIndex =
                imageContainer
                    .children(".image-row")
                    .length;


            const html = `
                        <div class="row image-row
                                    border rounded
                                    p-3 mb-2">

                            <!-- Image -->

                            <div class="col-md-5">

                                <label class="form-label">
                                    Image
                                </label>

                                <input type="file"
                                       name="Variants[${variantIndex}].Images[${imageIndex}].Image"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp" />

                            </div>


                            <!-- Display Order -->

                            <div class="col-md-3">

                                <label class="form-label">
                                    Display Order
                                </label>

                                <input type="number"
                                       name="Variants[${variantIndex}].Images[${imageIndex}].DisplayOrder"
                                       value="${imageIndex + 1}"
                                       min="1"
                                       class="form-control" />

                            </div>


                            <!-- Primary -->

                            <div class="col-md-2">

                                <div class="form-check mt-4">

                                    <input type="checkbox"
                                           name="Variants[${variantIndex}].Images[${imageIndex}].IsPrimary"
                                           value="true"
                                           class="form-check-input" />

                                    <label class="form-check-label">
                                        Primary
                                    </label>

                                </div>

                            </div>


                            <!-- Remove -->

                            <div class="col-md-2">

                                <button type="button"
                                        class="btn btn-danger remove-image mt-4">

                                    <i class="bx bx-trash me-1"></i>
                                    Remove

                                </button>

                            </div>

                        </div>
                    `;


            imageContainer.append(html);
        }


        // ==========================================
        // ADD VARIANT BUTTON
        // ==========================================

        $("#addVariant").click(function() {

            addVariant();

        });


        // ==========================================
        // ADD IMAGE BUTTON
        // ==========================================

        $(document).on(
            "click",
            ".add-image",
            function() {

                const variantCard =
                    $(this).closest(
                        ".variant-card"
                    );


                addImage(
                    variantCard
                );

            }
        );


        // ==========================================
        // REMOVE VARIANT
        // ==========================================

        $(document).on(
            "click",
            ".remove-variant",
            function() {

                $(this)
                    .closest(".variant-card")
                    .remove();


                reindex();

            }
        );


        // ==========================================
        // REMOVE IMAGE
        // ==========================================

        $(document).on(
            "click",
            ".remove-image",
            function() {

                $(this)
                    .closest(".image-row")
                    .remove();


                reindex();

            }
        );


        // ==========================================
        // REINDEX
        // ==========================================

        function reindex() {

            $("#variantsContainer")
                .children(".variant-card")
                .each(function(vIndex) {

                    const variantCard =
                        $(this);


                    // Update variant data-index

                    variantCard.attr(
                        "data-index",
                        vIndex
                    );


                    // Update variant fields

                    variantCard
                        .find("[name]")
                        .each(function() {

                            let name =
                                $(this).attr("name");


                            if (!name) {
                                return;
                            }


                            name =
                                name.replace(
                                    /Variants\[\d+\]/,
                                    `Variants[${vIndex}]`
                                );


                            $(this).attr(
                                "name",
                                name
                            );

                        });


                    // Update image indexes

                    variantCard
                        .find(".image-row")
                        .each(function(iIndex) {

                            $(this)
                                .find("[name]")
                                .each(function() {

                                    let name =
                                        $(this)
                                            .attr("name");


                                    if (!name) {
                                        return;
                                    }


                                    name =
                                        name.replace(
                                            /Images\[\d+\]/,
                                            `Images[${iIndex}]`
                                        );


                                    $(this).attr(
                                        "name",
                                        name
                                    );

                                });

                        });

                });


            // Keep next generated index safe

            variantIndex =
                $("#variantsContainer")
                    .children(".variant-card")
                    .length;
        }


        // ==========================================
        // DEFAULT ACTIVE
        // ==========================================

        $(function() {

            $("#IsActive")
                .prop("checked", true);

        });

    </script>
}

