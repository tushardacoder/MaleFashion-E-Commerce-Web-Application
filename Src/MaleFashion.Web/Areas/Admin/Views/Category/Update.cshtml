@model CategoryModel

@{
    Layout = "_Layout1";
    ViewData["Title"] = "Update Category";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row mb-6 gy-6">

        <div class="col-xl">

            <div class="card">

                <!-- Header -->
                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Edit Category
                    </h5>

                    <small class="text-body">
                        Change category information
                    </small>

                </div>


                <!-- Response -->
                <partial name="_ResponsePartial" />

                
           
                <!-- Body -->
                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Category"
                          asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Hidden ID -->
                        <input asp-for="Id"
                               type="hidden" />


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Category Name -->
                        <div class="mb-3">

                            <label asp-for="CategoryName"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="Enter category name" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Is Active -->
                        <div class="mb-4">

                            <div class="form-check">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       type="checkbox" />

                                <label asp-for="IsActive"
                                       class="form-check-label">
                                    Active
                                </label>

                            </div>

                            <small class="text-muted">
                                Active categories can be used for products.
                            </small>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bx bx-save me-1"></i>
                                Update

                            </button>


                            <a asp-area="Admin"
                               asp-controller="Category"
                               asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bx bx-arrow-back me-1"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}