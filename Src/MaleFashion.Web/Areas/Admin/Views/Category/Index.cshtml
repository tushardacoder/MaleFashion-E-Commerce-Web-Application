
@{
    Layout = "_Layout1";
    ViewData["Title"] = "Categories";
}

@section Styles
{
    <!-- =======================================================
         DATATABLES
    ======================================================== -->

    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">


    <!-- =======================================================
         SELECT2
    ======================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">


    <!-- =======================================================
         CUSTOM DATATABLE CSS
    ======================================================== -->

    <link rel="stylesheet"
          href="~/sneat/assets/css/custom-datatables.css">
}

<br />
<br />


<!-- =======================================================
     ADMIN MENU
======================================================= -->

<div class="container-fluid px-2">

    <div class="row g-3 justify-content-center align-items-center">

        <!-- HOME -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item home h-100"
               asp-area="Admin"
               asp-controller="Home"
               asp-action="Index">

                <i class="bx bx-home-alt"></i>

                <span>Home</span>

            </a>

        </div>


        <!-- CATEGORY -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item category h-100
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category"
                   ? "active"
                   : "")"
               asp-area="Admin"
               asp-controller="Category"
               asp-action="Index">

                <i class="bx bx-category-alt"></i>

                <span>Category</span>

            </a>

        </div>


        <!-- PRODUCT -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item product h-100"
               asp-area="Admin"
               asp-controller="Product"
               asp-action="Index">

                <i class="bx bx-box"></i>

                <span>Product</span>

            </a>

        </div>


        <!-- INVENTORY -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item inventory h-100"
               asp-area="Admin"
               asp-controller="Inventory"
               asp-action="Index">

                <i class="bx bx-archive-in"></i>

                <span>Inventory</span>

            </a>

        </div>


        <!-- ORDER -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item order h-100"
               asp-area="Admin"
               asp-controller="Order"
               asp-action="Index">

                <i class="bx bx-cart"></i>

                <span>Order</span>

            </a>

        </div>


        <!-- CONTACT -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item contact h-100"
               asp-area="Admin"
               asp-controller="Contact"
               asp-action="Index">

                <i class="bx bx-message-dots"></i>

                <span>Contact Messages</span>

            </a>

        </div>


        <!-- DISCOUNT -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item user h-100"
               asp-area="Admin"
               asp-controller="Discount"
               asp-action="Index">

                <i class="bx bx-group"></i>

                <span>Discount Management</span>

            </a>

        </div>


        <!-- USER -->
        <div class="col-6 col-md-4 col-xl-2">

            <a class="admin-menu-item user h-100"
               asp-area="Admin"
               asp-controller="User"
               asp-action="Index">

                <i class="bx bx-group"></i>

                <span>Users</span>

            </a>

        </div>

    </div>

</div>

<br />


<!-- =======================================================
     CATEGORY TABLE
======================================================= -->

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row">

        <div class="col-12">

            <partial name="_ResponsePartial" />


            <div class="card">


                <!-- ===================================================
                     HEADER
                ==================================================== -->

                <div class="card-header border-bottom
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="card-title mb-0">
                        View Categories
                    </h5>


                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Create"
                       class="btn btn-primary btn-sm">

                        Add Category

                    </a>

                </div>


                <!-- ===================================================
                     SEARCH
                ==================================================== -->

                <div class="card-body pb-0">

                    <div class="row g-3 mb-3">

                        <div class="col-md-4">

                            <label for="categorySearch"
                                   class="form-label">

                                Search

                            </label>

                            <input type="text"
                                   id="categorySearch"
                                   class="form-control"
                                   placeholder="Search category name..." />

                        </div>

                    </div>


                    <!-- =================================================
                         BUTTONS
                    ================================================== -->

                    <div class="d-flex justify-content-end
                        gap-2 mt-1 mb-3">

                        <button id="searchButton"
                                type="button"
                                class="btn btn-primary">

                            <i class="bx bx-search me-1"></i>

                            Search

                        </button>


                        <button id="resetButton"
                                type="button"
                                class="btn btn-outline-secondary">

                            <i class="bx bx-reset me-1"></i>

                            Reset

                        </button>

                    </div>

                </div>


                <!-- ===================================================
                     RESPONSE MESSAGE
                ==================================================== -->
                @{
                    var response =
                        TempData.Get<ResponseModel>(
                            Constants.ResponseTempKey);
                }

                @if (response != null)
                {
                    <div class="alert
                        alert-@(response.Type == ResponseTypes.Success
                                                            ? "success"
                                                            : "danger")
                        alert-dismissible
                        fade show"
                         role="alert">

                        @response.Message

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- ===================================================
                     TABLE
                ==================================================== -->

                <div class="card-body table-responsive pt-0">

                    <partial name="_ModalPartial" />


                    <table id="categories"
                           class="table table-bordered
                        table-hover w-100">

                        <thead>

                            <tr>

                                <th>
                                    Category Name
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <!-- =======================================================
         DATATABLES
    ======================================================== -->

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>


    <!-- =======================================================
         BUTTONS
    ======================================================== -->

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>


    <!-- =======================================================
         EXCEL
    ======================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>


    <!-- =======================================================
         PDF
    ======================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>


    <!-- =======================================================
         SELECT2
    ======================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


    <script>

        $(document).ready(function() {


            // =====================================================
            // DATATABLE
            // =====================================================

            const table = $("#categories").DataTable({

                processing: true,

                serverSide: true,

                responsive: true,

                searching: false,

                autoWidth: false,

                pagingType: "simple_numbers",


                // =================================================
                // AJAX
                // =================================================

                ajax: {

                    url: "/Admin/Category/GetPagedCategories",

                    type: "POST",

                    contentType: "application/json",

                    dataType: "json",


                    data: function(d) {

                        // -----------------------------------------
                        // CUSTOM SEARCH
                        // -----------------------------------------

                        d.search = d.search || {};

                        d.search.value =
                            $("#categorySearch").val().trim();


                        console.log("Sending request:", d);


                        return JSON.stringify(d);
                    },


                    dataSrc: function(json) {

                        console.log("Received response:", json);


                        // -----------------------------------------
                        // CHECK RESPONSE
                        // -----------------------------------------

                        if (!json) {

                            console.error(
                                "DataTables received empty response."
                            );

                            return [];
                        }


                        if (!Array.isArray(json.data)) {

                            console.error(
                                "json.data is not an array:",
                                json
                            );

                            return [];
                        }


                        console.log(
                            "Rows returned:",
                            json.data.length
                        );

                        console.log(
                            "Total:",
                            json.recordsTotal
                        );

                        console.log(
                            "Filtered:",
                            json.recordsFiltered
                        );


                        return json.data;
                    }

                },


                // =================================================
                // COLUMNS
                // =================================================

                columns: [

                    // ---------------------------------------------
                    // CATEGORY NAME
                    // ---------------------------------------------

                    {
                        data: "categoryName",

                        name: "CategoryName",

                        defaultContent: ""
                    },


                    // ---------------------------------------------
                    // STATUS
                    // ---------------------------------------------

                    {
                        data: "isActive",

                        name: "IsActive",

                        render: function(data) {

                            if (data === true) {

                                return `
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        `;

                            }


                            return `
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    `;
                        }

                    },


                    // ---------------------------------------------
                    // ACTION
                    // ---------------------------------------------

                    {
                        data: "id",

                        orderable: false,

                        searchable: false,

                        render: function(data) {

                            return `
                                        <div class="dropdown">

                                            <button
                                                class="btn btn-sm
                                                       btn-outline-primary
                                                       dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown">

                                                Actions

                                            </button>


                                            <ul class="dropdown-menu">

                                                <li>

                                                    <a
                                                        class="dropdown-item
                                                               text-warning"
                                                        href="/Admin/Category/Update/${data}">

                                                        <i class="bx bx-edit me-1"></i>

                                                        Edit

                                                    </a>

                                                </li>


                                                <li>

                                                    <button
                                                        type="button"
                                                        class="dropdown-item
                                                               text-danger
                                                               show-bs-modal"
                                                        data-id="${data}">

                                                        <i class="bx bx-trash me-1"></i>

                                                        Delete

                                                    </button>

                                                </li>

                                            </ul>

                                        </div>
                                    `;
                        }

                    }

                ],


                // =================================================
                // COLUMN DEFINITIONS
                // =================================================

                columnDefs: [

                    {
                        targets: 0,
                        orderable: true
                    },

                    {
                        targets: 1,
                        orderable: true
                    },

                    {
                        targets: 2,
                        orderable: false
                    }

                ],


                // =================================================
                // DEFAULT SORT
                // =================================================

                order: [
                    [0, "asc"]
                ]

            });


            // =====================================================
            // SEARCH
            // =====================================================

            $("#searchButton").on("click", function() {

                // -----------------------------------------------
                // IMPORTANT:
                // Go back to page 1 after searching.
                // -----------------------------------------------

                table.page("first").draw("page");

            });


            // =====================================================
            // ENTER KEY SEARCH
            // =====================================================

            $("#categorySearch").on("keydown", function(e) {

                if (e.key === "Enter") {

                    e.preventDefault();

                    table.page("first").draw("page");

                }

            });


            // =====================================================
            // RESET
            // =====================================================

            $("#resetButton").on("click", function() {

                $("#categorySearch").val("");


                // -----------------------------------------------
                // Reset to first page and reload.
                // -----------------------------------------------

                table.page("first").draw("page");

            });


            // =====================================================
            // DELETE MODAL
            // =====================================================

            $("#categories").on(
                "click",
                ".show-bs-modal",
                function() {


                    const id =
                        $(this).data("id");


                    const deleteModal =
                        $("#delete-modal");


                    // ---------------------------------------------
                    // MODAL TITLE
                    // ---------------------------------------------

                    deleteModal
                        .find("#modelLabel")
                        .text("Delete Category");


                    // ---------------------------------------------
                    // MODAL MESSAGE
                    // ---------------------------------------------

                    deleteModal
                        .find(".modal-body p")
                        .html(
                            "Are you sure you want to delete this category?"
                        );


                    // ---------------------------------------------
                    // CATEGORY ID
                    // ---------------------------------------------

                    $("#delete-id")
                        .val(id);


                    // ---------------------------------------------
                    // DELETE ACTION
                    // ---------------------------------------------

                    $("#delete-form")
                        .attr(
                            "action",
                            "/Admin/Category/Delete"
                        );


                    // ---------------------------------------------
                    // SHOW MODAL
                    // ---------------------------------------------

                    deleteModal.modal("show");

                }
            );


            // =====================================================
            // DELETE BUTTON
            // =====================================================

            $("#delete-btn").on(
                "click",
                function() {

                    $("#delete-form").submit();

                }
            );

        });

    </script>
}

