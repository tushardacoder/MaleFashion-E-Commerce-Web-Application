    <style>

            /* =========================================
                                           Admin Hot Menu
                                           ========================================= */

            .admin-management-menu {
                width: 100%;
                margin: 0 0 24px 0;
                padding: 0;
            }

            .admin-menu-item {
                width: 100%;
                min-height: 58px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 10px 12px;
                background: #fff;
                border: 1px solid #e7e7e7;
                border-radius: 8px;
                color: #566a7f;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                box-shadow: 0 2px 6px rgba(67, 89, 113, 0.08);
                transition: all 0.2s ease;
            }

                .admin-menu-item i {
                    font-size: 19px;
                    flex-shrink: 0;
                }

                .admin-menu-item span {
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .admin-menu-item:hover {
                    color: #696cff !important;
                    border-color: #696cff;
                    background: rgba(105, 108, 255, 0.04);
                    transform: translateY(-1px);
                    box-shadow: 0 4px 10px rgba(67, 89, 113, 0.10);
                }


                /* =========================================
                                           Icon Colors
                                           ========================================= */

                .admin-menu-item.home i {
                    color: #696cff;
                }

                .admin-menu-item.category i {
                    color: #696cff;
                }

                .admin-menu-item.product i {
                    color: #71dd37;
                }

                .admin-menu-item.order i {
                    color: #ff3e1d;
                }

                .admin-menu-item.inventory i {
                    color: #03c3ec;
                }

                .admin-menu-item.contact i {
                    color: #03c3ec;
                }

                .admin-menu-item.blog i {
                    color: #ffab00;
                }

                .admin-menu-item.faq i {
                    color: #8592a3;
                }


            /* =========================================
                                           Home
                                           ========================================= */

            /* .admin-menu-item.home {
                                background: rgba(105, 108, 255, 0.08);
                                border-color: rgba(105, 108, 255, 0.25);
                                color: #696cff;
                            }

                                .admin-menu-item.home:hover {
                                    background: rgba(105, 108, 255, 0.12);
                                    color: #696cff !important;
                                } */


            .admin-menu-item {
                transition: all 0.2s ease;
            }

                .admin-menu-item.active {
                    /* background: rgba(105, 108, 255, 0.08);
                                border-color: rgba(105, 108, 255, 0.25);
                                color: #696cff; */
                    color: #696cff !important;
                    border-color: #696cff;
                    background: rgba(105, 108, 255, 0.04);
                    transform: translateY(-1px);
                    box-shadow: 0 4px 10px rgba(67, 89, 113, 0.10);
                }

            /* .admin-menu-item.active i,
                                .admin-menu-item.active span {
                                    color: #fff;
                                } */
    </style>

    

          

