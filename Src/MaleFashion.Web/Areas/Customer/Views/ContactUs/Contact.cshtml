                <div class="col-lg-6 col-md-6">

                    <div class="contact__form">
                        @if (TempData.ContainsKey(Constants.ResponseTempKey))
                        {
                            var response = TempData.Get<ResponseModel>(Constants.ResponseTempKey);

                            if (response != null)
                            {
                                <div id="responseMessage"
                                     class="alert alert-@response.Type"
                                     role="alert">
                                    @response.Message
                                </div>
                            }
                        }



                        <form asp-controller="ContactUs"
                              asp-action="Contact"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger">
                            </div>

                            <div class="row">

                                <div class="col-lg-6">

                                    <input asp-for="Name"
                                           type="text"
                                           placeholder="Name">

                                    <span asp-validation-for="Name"
                                          class="text-danger">
                                    </span>

                                </div>

                                <div class="col-lg-6">

                                    <input asp-for="Email"
                                           type="email"
                                           placeholder="Email">

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>

                                </div>

                                <div class="col-lg-12">

                                    <textarea asp-for="Message"
                                              placeholder="Message"></textarea>

                                    <span asp-validation-for="Message"
                                          class="text-danger">
                                    </span>

                                    <input asp-for="RecaptchaToken"
                                           type="hidden"
                                           id="recaptchaToken" />

                                    <button type="submit"
                                            class="site-btn">
                                        Send Message
                                    </button>

                                </div>

                            </div>

                        </form>

