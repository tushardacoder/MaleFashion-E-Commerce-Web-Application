    <!-- =========================================================
         VARIANT + CART + WISHLIST JAVASCRIPT
    ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /* ==========================================
                   FORMS / INPUTS
                ========================================== */

                const wishlistForm =
                    document.getElementById(
                        "wishlistForm"
                    );


                const wishlistVariantId =
                    document.getElementById(
                        "wishlistVariantId"
                    );


                const cartForm =
                    document.getElementById(
                        "cartForm"
                    );


                const cartVariantId =
                    document.getElementById(
                        "cartVariantId"
                    );


                const cartQuantity =
                    document.getElementById(
                        "cartQuantity"
                    );


                const quantityInput =
                    document.getElementById(
                        "quantityInput"
                    );


                const cartErrorMessage =
                    document.getElementById(
                        "cartErrorMessage"
                    );


                const colorInputs =
                    document.querySelectorAll(
                        'input[name="product-color"]'
                    );


                const sizeInputs =
                    document.querySelectorAll(
                        'input[name="product-size"]'
                    );


                /* ==========================================
                   PRODUCT VARIANTS FROM SERVER
                ========================================== */

                
                     const variants = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.Variants)
    ) || [];

                console.log(
                    "Product Variants:",
                    variants
                );


                /* ==========================================
                   FIND SELECTED VARIANT
                ========================================== */

                function updateVariant() {

                    const selectedColor =
                        document.querySelector(
                            'input[name="product-color"]:checked'
                        )?.value;


                    const selectedSize =
                        document.querySelector(
                            'input[name="product-size"]:checked'
                        )?.value;


                    console.log(
                        "Selected Color:",
                        selectedColor
                    );


                    console.log(
                        "Selected Size:",
                        selectedSize
                    );


                    /* ======================================
                       RESET
                    ====================================== */

                    if (!selectedColor ||
                        !selectedSize) {

                        if (wishlistVariantId) {

                            wishlistVariantId.value = "";

                        }


                        if (cartVariantId) {

                            cartVariantId.value = "";

                        }

                        return;
                    }


                    /* ======================================
                       FIND VARIANT
                    ====================================== */

                    const variant =
                        variants.find(
                            function (v) {

                                return String(v.Color)
                                           .trim()
                                           .toLowerCase()
                                       ===
                                       String(selectedColor)
                                           .trim()
                                           .toLowerCase()

                                       &&

                                       String(v.Size)
                                           .trim()
                                           .toLowerCase()
                                       ===
                                       String(selectedSize)
                                           .trim()
                                           .toLowerCase();

                            }
                        );


                    /* ======================================
                       VARIANT FOUND
                    ====================================== */

                    if (variant) {

                        console.log(
                            "Selected Variant:",
                            variant
                        );


                        console.log(
                            "Selected Variant ID:",
                            variant.Id
                        );


                        if (wishlistVariantId) {

                            wishlistVariantId.value =
                                variant.Id;

                        }


                        if (cartVariantId) {

                            cartVariantId.value =
                                variant.Id;

                        }


                        if (cartErrorMessage) {

                            cartErrorMessage.style.display =
                                "none";

                        }

                    }
                    else {

                        console.log(
                            "No matching variant found."
                        );


                        if (wishlistVariantId) {

                            wishlistVariantId.value = "";

                        }


                        if (cartVariantId) {

                            cartVariantId.value = "";

                        }

                    }

                }


                /* ==========================================
                   COLOR CHANGE
                ========================================== */

                colorInputs.forEach(
                    function (input) {

                        input.addEventListener(
                            "change",
                            function () {

                                colorInputs.forEach(
                                    function (item) {

                                        const label =
                                            item.closest(
                                                ".dynamic-color-label"
                                            );

                                        if (label) {

                                            label.classList.remove(
                                                "selected"
                                            );

                                        }

                                    }
                                );


                                const selectedLabel =
                                    input.closest(
                                        ".dynamic-color-label"
                                    );


                                if (selectedLabel) {

                                    selectedLabel.classList.add(
                                        "selected"
                                    );

                                }


                                updateVariant();

                            }
                        );

                    }
                );


                /* ==========================================
                   SIZE CHANGE
                ========================================== */

                sizeInputs.forEach(
                    function (input) {

                        input.addEventListener(
                            "change",
                            function () {

                                sizeInputs.forEach(
                                    function (item) {

                                        const label =
                                            item.closest(
                                                ".size-option"
                                            );

                                        if (label) {

                                            label.classList.remove(
                                                "selected"
                                            );

                                        }

                                    }
                                );


                                const selectedLabel =
                                    input.closest(
                                        ".size-option"
                                    );


                                if (selectedLabel) {

                                    selectedLabel.classList.add(
                                        "selected"
                                    );

                                }


                                updateVariant();

                            }
                        );

                    }
                );


                /* ==========================================
                   QUANTITY
                ========================================== */

                if (quantityInput &&
                    cartQuantity) {

                    quantityInput.addEventListener(
                        "input",
                        function () {

                            let quantity =
                                parseInt(
                                    quantityInput.value
                                );


                            if (
                                isNaN(quantity) ||
                                quantity < 1
                            ) {

                                quantity = 1;

                            }


                            quantityInput.value =
                                quantity;


                            cartQuantity.value =
                                quantity;

                        }
                    );


                    quantityInput.addEventListener(
                        "change",
                        function () {

                            let quantity =
                                parseInt(
                                    quantityInput.value
                                );


                            if (
                                isNaN(quantity) ||
                                quantity < 1
                            ) {

                                quantity = 1;

                            }


                            quantityInput.value =
                                quantity;


                            cartQuantity.value =
                                quantity;

                        }
                    );

                }


                /* ==========================================
                   ADD TO CART SUBMIT
                ========================================== */

                if (cartForm) {

                    cartForm.addEventListener(
                        "submit",
                        function (event) {

                            /* ==============================
                               CHECK VARIANT
                            ============================== */

                            if (
                                !cartVariantId ||
                                !cartVariantId.value
                            ) {

                                event.preventDefault();


                                if (cartErrorMessage) {

                                    cartErrorMessage.innerText =
                                        "Please select a valid color and size.";

                                    cartErrorMessage.style.display =
                                        "block";

                                }


                                return;

                            }


                            /* ==============================
                               CHECK QUANTITY
                            ============================== */

                            let quantity =
                                parseInt(
                                    quantityInput?.value
                                );


                            if (
                                isNaN(quantity) ||
                                quantity <= 0
                            ) {

                                event.preventDefault();


                                if (cartErrorMessage) {

                                    cartErrorMessage.innerText =
                                        "Please enter a valid quantity.";

                                    cartErrorMessage.style.display =
                                        "block";

                                }


                                return;

                            }


                            /* ==============================
                               SET FINAL QUANTITY
                            ============================== */

                            cartQuantity.value =
                                quantity;

                        }
                    );

                }


                /* ==========================================
                   WISHLIST SUBMIT
                ========================================== */

                if (wishlistForm) {

                    wishlistForm.addEventListener(
                        "submit",
                        function (event) {

                            if (
                                !wishlistVariantId ||
                                !wishlistVariantId.value
                            ) {

                                event.preventDefault();


                                $("#wishlistModal")
                                    .modal("show");


                                return;

                            }

                        }
                    );

                }

            }
        );

    </script>



    <!-- =========================================================
         RELATED PRODUCT AUTOMATIC SLIDER
    ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                document
                    .querySelectorAll(
                        ".related-image-slider"
                    )
                    .forEach(
                        function (slider) {


                            /* ==================================
                               GET IMAGES
                            ================================== */

                            const images =
                                slider.querySelectorAll(
                                    ".related-product-img"
                                );


                            /* ==================================
                               GET BUTTONS
                            ================================== */

                            const prevButton =
                                slider.querySelector(
                                    ".related-prev"
                                );


                            const nextButton =
                                slider.querySelector(
                                    ".related-next"
                                );


                            /* ==================================
                               ONLY ONE IMAGE
                            ================================== */

                            if (images.length <= 1) {

                                return;

                            }


                            /* ==================================
                               CURRENT IMAGE
                            ================================== */

                            let currentIndex = 0;


                            /* ==================================
                               SLIDE TIME
                               2000 = 2 seconds
                            ================================== */

                            const slideInterval = 2000;


                            let autoSlide;


                            /* ==================================
                               SHOW IMAGE
                            ================================== */

                            function showImage(index) {

                                images.forEach(
                                    function (image, i) {

                                        if (i === index) {

                                            image.style.display =
                                                "block";

                                        }
                                        else {

                                            image.style.display =
                                                "none";

                                        }

                                    }
                                );

                            }


                            /* ==================================
                               NEXT
                            ================================== */

                            function nextImage() {

                                currentIndex++;


                                if (
                                    currentIndex >=
                                    images.length
                                ) {

                                    currentIndex = 0;

                                }


                                showImage(
                                    currentIndex
                                );

                            }


                            /* ==================================
                               PREVIOUS
                            ================================== */

                            function previousImage() {

                                currentIndex--;


                                if (
                                    currentIndex < 0
                                ) {

                                    currentIndex =
                                        images.length - 1;

                                }


                                showImage(
                                    currentIndex
                                );

                            }


                            /* ==================================
                               START AUTO SLIDE
                            ================================== */

                            function startAutoSlide() {

                                clearInterval(
                                    autoSlide
                                );


                                autoSlide =
                                    setInterval(
                                        function () {

                                            nextImage();

                                        },
                                        slideInterval
                                    );

                            }


                            /* ==================================
                               STOP AUTO SLIDE
                            ================================== */

                            function stopAutoSlide() {

                                clearInterval(
                                    autoSlide
                                );

                            }


                            /* ==================================
                               NEXT BUTTON
                            ================================== */

                            if (nextButton) {

                                nextButton.addEventListener(
                                    "click",
                                    function (event) {

                                        event.preventDefault();

                                        event.stopPropagation();


                                        nextImage();


                                        startAutoSlide();

                                    }
                                );

                            }


                            /* ==================================
                               PREVIOUS BUTTON
                            ================================== */

                            if (prevButton) {

                                prevButton.addEventListener(
                                    "click",
                                    function (event) {

                                        event.preventDefault();

                                        event.stopPropagation();


                                        previousImage();


                                        startAutoSlide();

                                    }
                                );

                            }


                            /* ==================================
                               INITIAL IMAGE
                            ================================== */

                            showImage(
                                currentIndex
                            );


                            /* ==================================
                               START SLIDER
                            ================================== */

                            startAutoSlide();


                            /* ==================================
                               PAUSE ON MOUSE ENTER
                            ================================== */

                            slider.addEventListener(
                                "mouseenter",
                                function () {

                                    stopAutoSlide();

                                }
                            );


                            /* ==================================
                               RESUME ON MOUSE LEAVE
                            ================================== */

                            slider.addEventListener(
                                "mouseleave",
                                function () {

                                    startAutoSlide();

                                }
                            );

                        }
                    );

            }
        );

        //inventory section

            const variants = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                            Model.Variants.Select(v => new
                                    {
                                        id = v.Id,
                                        color = v.Color,
                                        size = v.Size,
                                        stock = v.InventoryQuantity,
                                        isInStock = v.IsInStock
                                    })
                            )
                            );

            const quantityInput =
                document.getElementById("quantityInput");


            function updateQuantityLimit() {

                const selectedColor =
                    document.querySelector(
                        'input[name="product-color"]:checked'
                    )?.value;

                const selectedSize =
                    document.querySelector(
                        'input[name="product-size"]:checked'
                    )?.value;


                // User has not selected both
                if (!selectedColor || !selectedSize) {

                    quantityInput.disabled = true;

                    quantityInput.value = 1;

                    quantityInput.max = 1;

                    return;
                }


                // Find matching variant
                const variant = variants.find(v =>
                    v.color === selectedColor &&
                    v.size === selectedSize
                );


                // Variant doesn't exist
                if (!variant) {

                    quantityInput.disabled = true;

                    quantityInput.value = 1;

                    quantityInput.max = 1;

                    return;
                }


                // Variant exists but no stock
                if (!variant.isInStock ||
                    variant.stock <= 0) {

                    quantityInput.disabled = true;

                    quantityInput.value = 1;

                    quantityInput.max = 1;

                    return;
                }


                // ===============================
                // SET INVENTORY LIMIT
                // ===============================

                quantityInput.disabled = false;

                quantityInput.min = 1;

                quantityInput.max = variant.stock;

                quantityInput.value = 1;
            }


            // Size changed
            document
                .querySelectorAll('input[name="product-size"]')
                .forEach(input => {

                    input.addEventListener(
                        "change",
                        updateQuantityLimit
                    );

                });


            // Color changed
            document
                .querySelectorAll('input[name="product-color"]')
                .forEach(input => {

                    input.addEventListener(
                        "change",
                        updateQuantityLimit
                    );

                });


            // Prevent manually entering more than stock
            quantityInput.addEventListener("input", function() {

                const max = parseInt(this.max);

                let value = parseInt(this.value);


                if (isNaN(value) || value < 1) {

                    this.value = 1;

                    return;
                }


                if (value > max) {

                    this.value = max;
                }

            });
    </script>


