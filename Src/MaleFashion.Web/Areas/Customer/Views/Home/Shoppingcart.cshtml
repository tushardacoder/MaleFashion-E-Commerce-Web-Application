<style>

    .shopping-cart {
        padding-top: 80px;
        padding-bottom: 80px;
    }

    .cart-product-image {
        width: 90px;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f8f8f8;
    }

    .cart-product-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .cart-table table {
        width: 100%;
    }

    .cart-table th {
        font-weight: 700;
        padding: 15px;
    }

    .cart-table td {
        padding: 15px;
        vertical-align: middle;
    }

    .cart-item {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .cart-item-details h6 {
        margin-bottom: 5px;
        font-weight: 700;
    }

    .cart-item-details span {
        display: block;
        font-size: 13px;
        color: #777;
    }

    .quantity-control {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .quantity-btn {
        width: 30px;
        height: 30px;
        border: 1px solid #ddd;
        background: #fff;
        cursor: pointer;
    }

    .quantity-btn:hover {
        background: #f5f5f5;
    }

    .quantity-btn:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .quantity-number {
        width: 40px;
        height: 30px;
        border-top: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .remove-btn {
        border: none;
        background: transparent;
        color: #111;
        font-size: 18px;
        cursor: pointer;
    }

    .remove-btn:hover {
        color: red;
    }

    .cart-summary {
        padding: 30px;
        background: #f7f7f7;
    }

    .cart-summary ul {
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .cart-summary li {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .cart-summary li.total {
        border-top: 1px solid #ddd;
        padding-top: 15px;
        font-size: 18px;
        font-weight: 700;
    }

    .empty-cart {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-cart h4 {
        margin-bottom: 15px;
    }

    .cart-variant-id {
        font-size: 11px;
        color: #aaa;
    }

    .header-cart-total {
        margin-left: 12px;
    }

    /* AJAX LOADING */

    .cart-loading {
        opacity: 0.5;
        pointer-events: none;
    }

    .ajax-spinner {
        display: none;
        margin-left: 5px;
    }

    .ajax-spinner.active {
        display: inline-block;
    }

    /* Toast */

    .cart-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 99999;
        display: none;
        padding: 14px 22px;
        color: #fff;
        background: #111;
        border-radius: 4px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .cart-toast.success {
        background: #28a745;
    }

    .cart-toast.error {
        background: #dc3545;
    }

</style>


</head>

