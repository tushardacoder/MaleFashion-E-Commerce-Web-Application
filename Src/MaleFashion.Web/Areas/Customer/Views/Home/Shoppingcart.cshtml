
@model MaleFashion.Application.Features.Carts.Query.CartViewModel



@{
ViewData["Title"] = "Shopping Cart";


var cartItems =
    Model?.Items
            ?? new List<MaleFashion.Application.Features.Carts.Query.CartItemViewModel>();

var cartQuantity = cartItems.Sum(x => x.Quantity);

var cartTotal = Model?.Total ?? 0;
var cartSubtotal = Model?.Subtotal ?? 0;
var cartDiscount = Model?.Discount ?? 0;


}

