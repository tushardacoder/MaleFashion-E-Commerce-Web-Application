<!-- SHOPPING CART -->

<section class="shopping-cart">

    <div class="container">

        <!-- AJAX TOAST -->

        <div id="cartToast"
             class="cart-toast">
        </div>

        <div id="cartContainer">

            @if (cartItems.Any())
            {
                <div class="row">

                    <!-- CART ITEMS -->

                    <div class="col-lg-8">

                        <div class="cart-table">

                            <table>

                                <thead>

                                    <tr>

                                        <th>
                                            Product
                                        </th>

                                        <th>
                                            Price
                                        </th>

                                        <th>
                                            Quantity
                                        </th>

                                        <th>
                                            Total
                                        </th>

                                        <th>
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in cartItems)
                                    {
                                        <tr class="cart-row"
                                            data-variant-id="@item.ProductVariantId">

                                            <!-- PRODUCT -->

                                            <td>

                                                <div class="cart-item">

                                                    <div class="cart-product-image">

                                                        @if (!string.IsNullOrWhiteSpace(item.ImageName))
                                                        {
                                                            <img src="@Url.Content("~/uploads/products/" + item.ImageName)"
                                                                 alt="@item.ProductName">
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                No Image
                                                            </span>
                                                        }

                                                    </div>

                                                    <div class="cart-item-details">

                                                        <h6>
                                                            @item.ProductName
                                                        </h6>

                                                        @if (!string.IsNullOrEmpty(item.Branding))
                                                        {
                                                            <span>
                                                                Brand:
                                                                @item.Branding
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrEmpty(item.Size))
                                                        {
                                                            <span>
                                                                Size:
                                                                @item.Size
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrEmpty(item.Color))
                                                        {
                                                            <span>
                                                                Color:
                                                                @item.Color
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrEmpty(item.Sku))
                                                        {
                                                            <span>
                                                                SKU:
                                                                @item.Sku
                                                            </span>
                                                        }

                                                        <span class="cart-variant-id">

                                                            Variant ID:
                                                            @item.ProductVariantId

                                                        </span>

                                                    </div>

                                                </div>

                                            </td>

                                            <!-- PRICE -->

                                            <td>

                                                <span class="unit-price">

                                                    ৳@item.UnitPrice.ToString("N2")

                                                </span>

                                            </td>

                                            <!-- QUANTITY -->

                                            <td>

                                                <div class="quantity-control">

                                                    <!-- MINUS -->

                                                    <button type="button"
                                                            class="quantity-btn quantity-minus"
                                                            data-variant-id="@item.ProductVariantId"
                                                            data-quantity="@item.Quantity">

                                                        -

                                                    </button>

                                                    <!-- CURRENT -->

                                                    <span class="quantity-number quantity-value">

                                                        @item.Quantity

                                                    </span>

                                                    <!-- PLUS -->

                                                    <button type="button"
                                                            class="quantity-btn quantity-plus"
                                                            data-variant-id="@item.ProductVariantId"
                                                            data-quantity="@item.Quantity">

                                                        +

                                                    </button>

                                                    <span class="ajax-spinner">
                                                        <i class="fa fa-spinner fa-spin"></i>
                                                    </span>

                                                </div>

                                            </td>

                                            <!-- ITEM TOTAL -->

                                            <td>

                                                <strong class="item-total">

                                                    ৳@item.Total.ToString("N2")

                                                </strong>

                                            </td>

                                            <!-- REMOVE -->

                                            <td>

                                                <button type="button"
                                                        class="remove-btn ajax-remove"
                                                        data-variant-id="@item.ProductVariantId"
                                                        title="Remove">

                                                    <i class="fa fa-close"></i>

                                                </button>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <!-- CONTINUE SHOPPING -->

                        <div style="margin-top:30px;">

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Shop"
                               class="primary-btn">

                                CONTINUE SHOPPING

                            </a>

                        </div>

                    </div>

                    <!-- SUMMARY -->

                    <div class="col-lg-4">

                        <div class="cart-summary">

                            <h6 class="checkout__title">
                                Cart Summary
                            </h6>

                            <ul>

                                <li>

                                    <span>
                                        Subtotal
                                    </span>

                                    <span id="cartSubtotal">

                                        ৳@cartSubtotal.ToString("N2")

                                    </span>

                                </li>

                                @* <li>

                                    <span>
                                        Discount
                                    </span>

                                    <span id="cartDiscount">

                                        ৳@cartDiscount.ToString("N2")

                                    </span>

                                </li> *@

                                <li class="total">

                                    <span>
                                        Total
                                    </span>

                                    <span id="cartTotal">

                                        ৳@cartTotal.ToString("N2")

                                    </span>

                                </li>

                            </ul>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Checkout"
                               class="primary-btn"
                               style="
                                width:100%;
                                text-align:center;
                                margin-top:20px;">

                                PROCEED TO CHECKOUT

                            </a>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="empty-cart">

                    <h4>
                        Your shopping cart is empty.
                    </h4>

                    <p>
                        Add some products to your cart
                        to continue shopping.
                    </p>

                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Shop"
                       class="primary-btn">

                        START SHOPPING

                    </a>

                </div>
            }

        </div>

    </div>

</section>

