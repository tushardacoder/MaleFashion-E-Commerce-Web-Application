<!-- ========================================================= -->
<!-- AJAX CART -->
<!-- ========================================================= -->

<script>

    /*
     * =========================================================
     * CART AJAX URLS
     * =========================================================
     */

    const updateCartUrl =
        '@Url.Action("UpdateCartQuantity", "Home", new { area = "Customer" })';

    const removeCartUrl =
        '@Url.Action("RemoveFromCart", "Home", new { area = "Customer" })';


    /*
     * =========================================================
     * ANTI FORGERY TOKEN
     * =========================================================
     */

    const antiForgeryToken =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        )?.value;


    /*
     * =========================================================
     * TOAST
     * =========================================================
     */

    function showCartToast(message, type = "success")
    {
        const toast =
            document.getElementById("cartToast");

        toast.textContent = message;

        toast.className =
            "cart-toast " + type;

        toast.style.display = "block";

        setTimeout(function ()
        {
            toast.style.display = "none";

        }, 2500);
    }


    /*
     * =========================================================
     * FORMAT MONEY
     * =========================================================
     */

    function formatMoney(value)
    {
        return "৳" +
            Number(value).toLocaleString(
                "en-US",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
    }


    /*
     * =========================================================
     * UPDATE HEADER
     * =========================================================
     */

    function updateHeader(cart)
    {
        const headerQuantity =
            document.getElementById("headerCartQuantity");

        const headerTotal =
            document.getElementById("headerCartTotal");

        const offcanvasQuantity =
            document.getElementById("offcanvasCartQuantity");

        const offcanvasTotal =
            document.getElementById("offcanvasCartTotal");


        if (headerQuantity)
        {
            headerQuantity.textContent =
                cart.quantity;
        }


        if (headerTotal)
        {
            headerTotal.textContent =
                formatMoney(cart.total);
        }


        if (offcanvasQuantity)
        {
            offcanvasQuantity.textContent =
                cart.quantity;
        }


        if (offcanvasTotal)
        {
            offcanvasTotal.textContent =
                formatMoney(cart.total);
        }
    }


    /*
     * =========================================================
     * UPDATE SUMMARY
     * =========================================================
     */

    function updateSummary(cart)
    {
        const subtotal =
            document.getElementById("cartSubtotal");

        const discount =
            document.getElementById("cartDiscount");

        const total =
            document.getElementById("cartTotal");


        if (subtotal)
        {
            subtotal.textContent =
                formatMoney(cart.subtotal);
        }


        if (discount)
        {
            discount.textContent =
                formatMoney(cart.discount);
        }


        if (total)
        {
            total.textContent =
                formatMoney(cart.total);
        }
    }


    /*
     * =========================================================
     * UPDATE CART FROM SERVER
     * =========================================================
     */

    async function refreshCart()
    {
        const response =
            await fetch(
                '@Url.Action("Shoppingcart", "Home", new { area = "Customer" })',
                {
                    method: "GET",
                    headers:
                    {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                }
            );


        if (!response.ok)
        {
            throw new Error(
                "Unable to refresh cart."
            );
        }


        const html =
            await response.text();


        const parser =
            new DOMParser();


        const doc =
            parser.parseFromString(
                html,
                "text/html"
            );


        const newCartContainer =
            doc.querySelector("#cartContainer");


        const currentCartContainer =
            document.querySelector("#cartContainer");


        if (newCartContainer &&
            currentCartContainer)
        {
            currentCartContainer.innerHTML =
                newCartContainer.innerHTML;
        }


        /*
         * Read updated header values
         */

        const newHeaderQuantity =
            doc.querySelector("#headerCartQuantity");

        const newHeaderTotal =
            doc.querySelector("#headerCartTotal");


        const currentHeaderQuantity =
            document.querySelector("#headerCartQuantity");

        const currentHeaderTotal =
            document.querySelector("#headerCartTotal");


        if (newHeaderQuantity &&
            currentHeaderQuantity)
        {
            currentHeaderQuantity.textContent =
                newHeaderQuantity.textContent.trim();
        }


        if (newHeaderTotal &&
            currentHeaderTotal)
        {
            currentHeaderTotal.textContent =
                newHeaderTotal.textContent.trim();
        }


        /*
         * Re-read offcanvas values
         */

        const newOffcanvasQuantity =
            doc.querySelector(
                "#offcanvasCartQuantity"
            );

        const newOffcanvasTotal =
            doc.querySelector(
                "#offcanvasCartTotal"
            );


        const currentOffcanvasQuantity =
            document.querySelector(
                "#offcanvasCartQuantity"
            );

        const currentOffcanvasTotal =
            document.querySelector(
                "#offcanvasCartTotal"
            );


        if (newOffcanvasQuantity &&
            currentOffcanvasQuantity)
        {
            currentOffcanvasQuantity.textContent =
                newOffcanvasQuantity.textContent.trim();
        }


        if (newOffcanvasTotal &&
            currentOffcanvasTotal)
        {
            currentOffcanvasTotal.textContent =
                newOffcanvasTotal.textContent.trim();
        }
    }


    /*
     * =========================================================
     * UPDATE QUANTITY
     * =========================================================
     */

    async function updateQuantity(
        productVariantId,
        quantity,
        row)
    {
        if (quantity < 1)
        {
            return;
        }


        if (row.classList.contains("cart-loading"))
        {
            return;
        }


        row.classList.add("cart-loading");


        const spinner =
            row.querySelector(".ajax-spinner");


        if (spinner)
        {
            spinner.classList.add("active");
        }


        try
        {
            const formData =
                new FormData();


            formData.append(
                "productVariantId",
                productVariantId
            );


            formData.append(
                "quantity",
                quantity
            );


            formData.append(
                "__RequestVerificationToken",
                antiForgeryToken
            );


            const response =
                await fetch(
                    updateCartUrl,
                    {
                        method: "POST",
                        body: formData,
                        headers:
                        {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );


            if (!response.ok)
            {
                throw new Error(
                    "Server error."
                );
            }


            const result =
                await response.json();


            if (!result.success)
            {
                showCartToast(
                    result.message ||
                    "Unable to update cart.",
                    "error"
                );

                return;
            }


            /*
             * Reload only cart HTML.
             *
             * The browser page itself does NOT reload.
             */

            await refreshCart();


            showCartToast(
                "Cart updated successfully.",
                "success"
            );
        }
        catch (error)
        {
            console.error(error);

            showCartToast(
                "Something went wrong while updating the cart.",
                "error"
            );
        }
        finally
        {
            row.classList.remove(
                "cart-loading"
            );

            if (spinner)
            {
                spinner.classList.remove(
                    "active"
                );
            }
        }
    }


    /*
     * =========================================================
     * REMOVE ITEM
     * =========================================================
     */

    async function removeCartItem(
        productVariantId,
        row)
    {
        if (row.classList.contains("cart-loading"))
        {
            return;
        }


        row.classList.add(
            "cart-loading"
        );


        try
        {
            const formData =
                new FormData();


            formData.append(
                "productVariantId",
                productVariantId
            );


            formData.append(
                "__RequestVerificationToken",
                antiForgeryToken
            );


            const response =
                await fetch(
                    removeCartUrl,
                    {
                        method: "POST",
                        body: formData,
                        headers:
                        {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );


            if (!response.ok)
            {
                throw new Error(
                    "Server error."
                );
            }


            const result =
                await response.json();


            if (!result.success)
            {
                showCartToast(
                    result.message ||
                    "Unable to remove item.",
                    "error"
                );

                return;
            }


            /*
             * Remove row immediately
             */

            row.remove();


            /*
             * Refresh complete cart section
             *
             * This also handles the empty cart.
             */

            await refreshCart();


            showCartToast(
                "Item removed from cart.",
                "success"
            );
        }
        catch (error)
        {
            console.error(error);

            showCartToast(
                "Something went wrong while removing the item.",
                "error"
            );
        }
        finally
        {
            row.classList.remove(
                "cart-loading"
            );
        }
    }


    /*
     * =========================================================
     * EVENT DELEGATION
     * =========================================================
     *
     * Important:
     *
     * refreshCart() replaces #cartContainer HTML.
     *
     * Therefore we use event delegation on document.
     *
     * This means the new +, -, and remove buttons
     * automatically continue working.
     */

    document.addEventListener(
        "click",
        function (event)
        {
            /*
             * PLUS
             */

            const plusButton =
                event.target.closest(
                    ".quantity-plus"
                );


            if (plusButton)
            {
                event.preventDefault();


                const row =
                    plusButton.closest(
                        ".cart-row"
                    );


                const variantId =
                    plusButton.dataset.variantId;


                const currentQuantity =
                    parseInt(
                        plusButton.dataset.quantity
                    );


                updateQuantity(
                    variantId,
                    currentQuantity + 1,
                    row
                );

                return;
            }


            /*
             * MINUS
             */

            const minusButton =
                event.target.closest(
                    ".quantity-minus"
                );


            if (minusButton)
            {
                event.preventDefault();


                const row =
                    minusButton.closest(
                        ".cart-row"
                    );


                const variantId =
                    minusButton.dataset.variantId;


                const currentQuantity =
                    parseInt(
                        minusButton.dataset.quantity
                    );


                if (currentQuantity <= 1)
                {
                    return;
                }


                updateQuantity(
                    variantId,
                    currentQuantity - 1,
                    row
                );

                return;
            }


            /*
             * REMOVE
             */

            const removeButton =
                event.target.closest(
                    ".ajax-remove"
                );


            if (removeButton)
            {
                event.preventDefault();


                const row =
                    removeButton.closest(
                        ".cart-row"
                    );


                const variantId =
                    removeButton.dataset.variantId;


                removeCartItem(
                    variantId,
                    row
                );

                return;
            }

        }
    );

</script>


</body>

</html>
