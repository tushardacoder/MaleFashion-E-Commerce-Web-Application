    ========================================================= -->
   
    <!-- =========================================================
     CHECKOUT JAVASCRIPT
========================================================= -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                /* =========================================================
                   FORM
                ========================================================= */

                const checkoutForm =
                    document.getElementById("checkoutForm");


                /* =========================================================
                   BKASH MODAL
                ========================================================= */

                const bkashModal =
                    document.getElementById("bkashModal");

                const bkashOption =
                    document.getElementById("bkashOption");

                const codOption =
                    document.getElementById("codOption");

                const bkashClose =
                    document.getElementById("bkashClose");

                const bkashCancelButton =
                    document.getElementById("bkashCancelButton");

                const bkashSendOtpButton =
                    document.getElementById("bkashSendOtpButton");

                const bkashConfirmButton =
                    document.getElementById("bkashConfirmButton");

                const bkashBackButton =
                    document.getElementById("bkashBackButton");


                /* =========================================================
                   BKASH INPUTS
                ========================================================= */

                const bkashMobileNumber =
                    document.getElementById("bkashMobileNumber");

                const bkashPin =
                    document.getElementById("bkashPin");

                const bkashOtp =
                    document.getElementById("bkashOtp");


                /* =========================================================
                   HIDDEN FORM FIELDS
                ========================================================= */

                const mobileNumberHidden =
                    document.getElementById("mobileNumberHidden");

                const transactionIdHidden =
                    document.getElementById("transactionIdHidden");


                /* =========================================================
                   BKASH STEPS
                ========================================================= */

                const bkashLoginStep =
                    document.getElementById("bkashLoginStep");

                const bkashOtpStep =
                    document.getElementById("bkashOtpStep");

                const bkashSuccessStep =
                    document.getElementById("bkashSuccessStep");


                /* =========================================================
                   OTP
                ========================================================= */

                const simulatedOtp =
                    document.getElementById("simulatedOtp");

                const simulatedOtpBox =
                    document.getElementById("simulatedOtpBox");


                /* =========================================================
                   ERRORS
                ========================================================= */

                const bkashMobileError =
                    document.getElementById("bkashMobileError");

                const bkashPinError =
                    document.getElementById("bkashPinError");

                const bkashOtpError =
                    document.getElementById("bkashOtpError");


                /* =========================================================
                   TRANSACTION ID
                ========================================================= */

                const bkashTransactionId =
                    document.getElementById("bkashTransactionId");


                /* =========================================================
                   GENERATED OTP
                ========================================================= */

                let generatedOtp = null;


                /* =========================================================
                   OPEN MODAL
                ========================================================= */

                function openBkashModal() {

                    if (!bkashModal) {
                        return;
                    }

                    bkashModal.classList.add("show");

                    showBkashLoginStep();
                }


                /* =========================================================
                   CLOSE MODAL
                ========================================================= */

                function closeBkashModal() {

                    if (!bkashModal) {
                        return;
                    }

                    bkashModal.classList.remove("show");

                    resetBkashModal();
                }


                /* =========================================================
                   LOGIN STEP
                ========================================================= */

                function showBkashLoginStep() {

                    if (bkashLoginStep) {
                        bkashLoginStep.style.display = "block";
                    }

                    if (bkashOtpStep) {
                        bkashOtpStep.style.display = "none";
                    }

                    if (bkashSuccessStep) {
                        bkashSuccessStep.style.display = "none";
                    }
                }


                /* =========================================================
                   OTP STEP
                ========================================================= */

                function showBkashOtpStep() {

                    if (bkashLoginStep) {
                        bkashLoginStep.style.display = "none";
                    }

                    if (bkashOtpStep) {
                        bkashOtpStep.style.display = "block";
                    }

                    if (bkashSuccessStep) {
                        bkashSuccessStep.style.display = "none";
                    }
                }


                /* =========================================================
                   SUCCESS STEP
                ========================================================= */

                function showBkashSuccessStep() {

                    if (bkashLoginStep) {
                        bkashLoginStep.style.display = "none";
                    }

                    if (bkashOtpStep) {
                        bkashOtpStep.style.display = "none";
                    }

                    if (bkashSuccessStep) {
                        bkashSuccessStep.style.display = "block";
                    }
                }


                /* =========================================================
                   RESET BKASH
                ========================================================= */

                function resetBkashModal() {

                    if (bkashMobileNumber) {
                        bkashMobileNumber.value = "";
                    }

                    if (bkashPin) {
                        bkashPin.value = "";
                    }

                    if (bkashOtp) {
                        bkashOtp.value = "";
                    }

                    generatedOtp = null;


                    if (mobileNumberHidden) {
                        mobileNumberHidden.value = "";
                    }

                    if (transactionIdHidden) {
                        transactionIdHidden.value = "";
                    }


                    if (bkashMobileError) {

                        bkashMobileError.style.display = "none";

                        bkashMobileError.textContent = "";
                    }


                    if (bkashPinError) {

                        bkashPinError.style.display = "none";

                        bkashPinError.textContent = "";
                    }


                    if (bkashOtpError) {

                        bkashOtpError.style.display = "none";

                        bkashOtpError.textContent = "";
                    }


                    if (simulatedOtpBox) {
                        simulatedOtpBox.style.display = "none";
                    }


                    showBkashLoginStep();
                }


                /* =========================================================
                   VALIDATE MOBILE
                ========================================================= */

                function validateBkashMobile() {

                    if (!bkashMobileNumber) {
                        return false;
                    }

                    const mobile =
                        bkashMobileNumber.value.trim();

                    const mobileRegex =
                        /^01[3-9]\d{8}$/;


                    if (!mobileRegex.test(mobile)) {

                        if (bkashMobileError) {

                            bkashMobileError.textContent =
                                "Enter a valid 11 digit bKash mobile number.";

                            bkashMobileError.style.display =
                                "block";
                        }

                        return false;
                    }


                    if (bkashMobileError) {

                        bkashMobileError.style.display =
                            "none";

                        bkashMobileError.textContent =
                            "";
                    }

                    return true;
                }


                /* =========================================================
                   VALIDATE PIN
                ========================================================= */

                function validateBkashPin() {

                    if (!bkashPin) {
                        return false;
                    }

                    const pin =
                        bkashPin.value.trim();

                    const pinRegex =
                        /^\d{5}$/;


                    if (!pinRegex.test(pin)) {

                        if (bkashPinError) {

                            bkashPinError.textContent =
                                "PIN must contain exactly 5 digits.";

                            bkashPinError.style.display =
                                "block";
                        }

                        return false;
                    }


                    if (bkashPinError) {

                        bkashPinError.style.display =
                            "none";

                        bkashPinError.textContent =
                            "";
                    }

                    return true;
                }


                /* =========================================================
                   SEND OTP
                ========================================================= */

                if (bkashSendOtpButton) {

                    bkashSendOtpButton.addEventListener(
                        "click",
                        function() {

                            const mobileValid =
                                validateBkashMobile();

                            const pinValid =
                                validateBkashPin();


                            if (!mobileValid || !pinValid) {
                                return;
                            }


                            /*
                             * Save mobile number.
                             *
                             * PIN is NEVER stored.
                             */

                            if (mobileNumberHidden) {

                                mobileNumberHidden.value =
                                    bkashMobileNumber.value.trim();
                            }


                            /*
                             * Generate simulated OTP.
                             */

                            generatedOtp =
                                Math.floor(
                                    100000 +
                                    Math.random() * 900000
                                ).toString();


                            /*
                             * Display OTP.
                             */

                            if (simulatedOtp) {

                                simulatedOtp.textContent =
                                    generatedOtp;
                            }


                            if (simulatedOtpBox) {

                                simulatedOtpBox.style.display =
                                    "block";
                            }


                            /*
                             * Move to OTP step.
                             */

                            showBkashOtpStep();

                        }
                    );
                }


                /* =========================================================
                   CONFIRM OTP
                ========================================================= */

                if (bkashConfirmButton) {

                    bkashConfirmButton.addEventListener(
                        "click",
                        function() {

                            if (!bkashOtp) {
                                return;
                            }

                            const enteredOtp =
                                bkashOtp.value.trim();


                            /*
                             * Validate OTP format.
                             */

                            if (!/^\d{6}$/.test(enteredOtp)) {

                                if (bkashOtpError) {

                                    bkashOtpError.textContent =
                                        "OTP must contain 6 digits.";

                                    bkashOtpError.style.display =
                                        "block";
                                }

                                return;
                            }


                            /*
                             * Verify OTP.
                             */

                            if (enteredOtp !== generatedOtp) {

                                if (bkashOtpError) {

                                    bkashOtpError.textContent =
                                        "Invalid OTP.";

                                    bkashOtpError.style.display =
                                        "block";
                                }

                                return;
                            }


                            /*
                             * OTP successful.
                             */

                            if (bkashOtpError) {

                                bkashOtpError.style.display =
                                    "none";

                                bkashOtpError.textContent =
                                    "";
                            }


                            /*
                             * Generate transaction ID.
                             */

                            const transactionId =
                                "SIM-" +
                                Date.now();


                            /*
                             * Save transaction ID.
                             */

                            if (transactionIdHidden) {

                                transactionIdHidden.value =
                                    transactionId;
                            }


                            /*
                             * Display transaction ID.
                             */

                            if (bkashTransactionId) {

                                bkashTransactionId.textContent =
                                    transactionId;
                            }


                            /*
                             * Show success.
                             */

                            showBkashSuccessStep();


                            /*
                             * Submit checkout form.
                             */

                            setTimeout(
                                function() {

                                    if (checkoutForm) {

                                        checkoutForm.submit();
                                    }

                                },
                                1200
                            );

                        }
                    );
                }


                /* =========================================================
                   BACK BUTTON
                ========================================================= */

                if (bkashBackButton) {

                    bkashBackButton.addEventListener(
                        "click",
                        function() {

                            showBkashLoginStep();

                        }
                    );
                }


                /* =========================================================
                   PAYMENT RADIO BUTTONS
                ========================================================= */

                document
                    .querySelectorAll(
                        'input[name="PaymentType"]'
                    )
                    .forEach(
                        function(radio) {

                            radio.addEventListener(
                                "change",
                                function() {

                                    if (this.value === "Bkash") {

                                        if (codOption) {

                                            codOption.classList.remove(
                                                "active"
                                            );
                                        }


                                        if (bkashOption) {

                                            bkashOption.classList.add(
                                                "active"
                                            );
                                        }


                                        openBkashModal();

                                    }

                                    else {

                                        if (bkashOption) {

                                            bkashOption.classList.remove(
                                                "active"
                                            );
                                        }


                                        if (codOption) {

                                            codOption.classList.add(
                                                "active"
                                            );
                                        }


                                        closeBkashModal();
                                    }

                                }
                            );

                        }
                    );


                /* =========================================================
                   SET COD
                ========================================================= */

                function setCashOnDelivery() {

                    const codRadio =
                        document.querySelector(
                            'input[name="PaymentType"][value="CashOnDelivery"]'
                        );


                    if (codRadio) {

                        codRadio.checked =
                            true;
                    }


                    if (bkashOption) {

                        bkashOption.classList.remove(
                            "active"
                        );
                    }


                    if (codOption) {

                        codOption.classList.add(
                            "active"
                        );
                    }
                }


                /* =========================================================
                   CLOSE BUTTON
                ========================================================= */

                if (bkashClose) {

                    bkashClose.addEventListener(
                        "click",
                        function() {

                            closeBkashModal();

                            setCashOnDelivery();

                        }
                    );
                }


                /* =========================================================
                   CANCEL BUTTON
                ========================================================= */

                if (bkashCancelButton) {

                    bkashCancelButton.addEventListener(
                        "click",
                        function() {

                            closeBkashModal();

                            setCashOnDelivery();

                        }
                    );
                }


                /* =========================================================
                   CLICK OUTSIDE MODAL
                ========================================================= */

                if (bkashModal) {

                    bkashModal.addEventListener(
                        "click",
                        function(event) {

                            if (event.target === bkashModal) {

                                closeBkashModal();

                                setCashOnDelivery();
                            }

                        }
                    );
                }


                /* =========================================================
                   FORM SUBMIT
                ========================================================= */

                if (checkoutForm) {

                    checkoutForm.addEventListener(
                        "submit",
                        function(event) {

                            const paymentType =
                                document.querySelector(
                                    'input[name="PaymentType"]:checked'
                                )?.value;


                            /* =================================================
                               COD
                            ================================================= */

                            if (paymentType === "CashOnDelivery") {

                                return;
                            }


                            /* =================================================
                               BKASH
                            ================================================= */

                            if (paymentType === "Bkash") {

                                /*
                                 * User must complete simulated
                                 * bKash payment first.
                                 */

                                if (
                                    !mobileNumberHidden ||
                                    !mobileNumberHidden.value ||
                                    !transactionIdHidden ||
                                    !transactionIdHidden.value
                                ) {

                                    event.preventDefault();

                                    openBkashModal();

                                    return;
                                }
                            }

                        }
                    );
                }

            });

    </script>
    


</body>

</html>