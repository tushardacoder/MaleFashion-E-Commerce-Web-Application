                        <!-- =================================================
                             ORDER SUMMARY
                        ================================================= -->

                        <div class="col-lg-5">

                            <div class="checkout__order">

                                <h4>
                                    Your Order
                                </h4>


                                <!-- =================================================
                                     PRODUCTS
                                ================================================= -->

                                <ul class="checkout__order__products">

                                    <li class="product-header">

                                        <span>
                                            Product
                                        </span>

                                        <span>
                                            Total
                                        </span>

                                    </li>


                                    @foreach (var item in cartItems)
                                    {
                                        <li>

                                            <div class="checkout-product">

                                                <!-- IMAGE -->

                                                <div class="checkout-product-image">

                                                    @if (!string.IsNullOrWhiteSpace(item.ImageName))
                                                    {
                                                        <img src="@Url.Content("~/uploads/products/" + item.ImageName)"
                                                             alt="@item.ProductName">
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            No Image
                                                        </span>
                                                    }

                                                </div>


                                                <!-- DETAILS -->

                                                <div class="checkout-product-details">

                                                    <h6>
                                                        @item.ProductName
                                                    </h6>


                                                    @if (!string.IsNullOrEmpty(item.Size))
                                                    {
                                                        <span>
                                                            Size: @item.Size
                                                        </span>
                                                    }


                                                    @if (!string.IsNullOrEmpty(item.Color))
                                                    {
                                                        <span>
                                                            Color: @item.Color
                                                        </span>
                                                    }


                                                    <span>
                                                        Qty: @item.Quantity
                                                    </span>

                                                </div>

                                            </div>


                                            <!-- PRODUCT TOTAL -->

                                            <span>

                                                ৳@item.Total.ToString("N2")

                                            </span>

                                        </li>
                                    }

                                </ul>


                                <!-- =================================================
                                     SUBTOTAL
                                ================================================= -->

                                <ul>

                                    <li class="checkout__order__subtotal">

                                        <span>
                                            Subtotal
                                        </span>

                                        <span>

                                            ৳@cartSubtotal.ToString("N2")

                                        </span>

                                    </li>


                                    <!-- =================================================
                                         DISCOUNT PERCENTAGE
                                    ================================================= -->

                                    <li class="checkout__order__discount">

                                        <span>
                                            Discount
                                        </span>

                                        <span>

                                            @if (discountPercentage > 0)
                                            {
                                                <span>

                                                    ৳@cartDiscount.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    0%
                                                </span>
                                            }

                                        </span>

                                    </li>


                                    <!-- =================================================
                                         APPLY DISCOUNT BUTTON
                                    ================================================= -->
                                    @* <li class="apply-discount-wrapper">

                                        <button type="button"
                                                id="applyDiscountButton"
                                                class="apply-discount-btn">

                                            APPLY DISCOUNT

                                        </button>

                                    </li> *@


                                    <!-- =================================================
                                         ACTUAL DISCOUNT AMOUNT
                                    ================================================= -->

                                    <li class="checkout__order__discount discount-amount-row"
                                        id="discountAmountRow">

                                        <span>
                                            Discount Amount
                                        </span>

                                        <span class="discount-value"
                                              id="discountAmount">

                                            ৳0.00

                                        </span>

                                    </li>


                                    <!-- =================================================
                                         FINAL TOTAL
                                    ================================================= -->

                                    <li class="checkout__order__total">

                                        <span>
                                            Total
