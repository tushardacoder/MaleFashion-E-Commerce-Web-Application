            </div>


            <!-- =====================================================
             STEP 1 - MOBILE + PIN
        ====================================================== -->

            <div id="bkashLoginStep">

                <div class="checkout__input">

                    <p>
                        bKash Mobile Number
                        <span>*</span>
                    </p>

                    <input type="text"
                           id="bkashMobileNumber"
                           maxlength="11"
                           inputmode="numeric"
                           placeholder="01XXXXXXXXX"
                           autocomplete="off">

                    <small id="bkashMobileError"
                           style="
                        display:none;
                        color:#dc3545;
                        margin-top:5px;">
                    </small>

                </div>


                <div class="checkout__input">

                    <p>
                        bKash PIN
                        <span>*</span>
                    </p>

                    <input type="password"
                           id="bkashPin"
                           maxlength="5"
                           inputmode="numeric"
                           placeholder="Enter 5 digit PIN"
                           autocomplete="off">

                    <small id="bkashPinError"
                           style="
                        display:none;
                        color:#dc3545;
                        margin-top:5px;">
                    </small>

                </div>


                <p class="bkash-info">

                    Enter your simulated bKash mobile number
                    and PIN to continue.

                </p>


                <button type="button"
                        class="bkash-pay-btn"
                        id="bkashSendOtpButton">

                    SEND OTP

                </button>


                <button type="button"
                        class="bkash-cancel-btn"
                        id="bkashCancelButton">

                    CANCEL

                </button>

            </div>


            <!-- =====================================================
             STEP 2 - OTP
        ====================================================== -->

            <div id="bkashOtpStep"
                 style="display:none;">

                <div class="checkout__input">

                    <p>
                        OTP
                        <span>*</span>
                    </p>

                    <input type="text"
                           id="bkashOtp"
                           maxlength="6"
                           inputmode="numeric"
                           placeholder="Enter 6 digit OTP"
                           autocomplete="off">

                    <small id="bkashOtpError"
                           style="
                        display:none;
                        color:#dc3545;
                        margin-top:5px;">
                    </small>

                </div>


                <!-- SIMULATION OTP -->

                <div id="simulatedOtpBox"
                     style="
                    background:#f7f7f7;
                    padding:12px;
                    margin-bottom:15px;
                    text-align:center;
                    display:none;">

                    <small>
                        Simulation OTP
                    </small>

                    <strong id="simulatedOtp"
                            style="
                        display:block;
                        font-size:20px;
                        margin-top:5px;">
                    </strong>

                </div>


                <p class="bkash-info">

                    A simulated OTP has been sent to your
                    bKash mobile number.

                </p>


                <button type="button"
                        class="bkash-pay-btn"
                        id="bkashConfirmButton">

                    CONFIRM PAYMENT

                </button>


                <button type="button"
                        class="bkash-cancel-btn"
                        id="bkashBackButton">

                    BACK

                </button>

            </div>


            <!-- =====================================================
             STEP 3 - SUCCESS
        ====================================================== -->

            <div id="bkashSuccessStep"
                 style="
                display:none;
                text-align:center;">

                <div style="
                    font-size:50px;
                    margin-bottom:15px;">

                    ✓

                </div>

                <h5>
                    Payment Successful
                </h5>

                <p style="
                    color:#777;
                    font-size:13px;
                    margin-top:10px;">

                    Your bKash payment has been completed.

                </p>

                <p>

                    TrxID:

                    <strong id="bkashTransactionId">
                    </strong>

                </p>

            </div>

        </div>

