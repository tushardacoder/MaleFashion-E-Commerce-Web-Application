@model MaleFashion.Application.Features.Carts.Query.CartViewModel

@{
    ViewData["Title"] = "Checkout";

    // =========================================================
    // CART ITEMS
    // =========================================================

    var cartItems =
        Model?.Items
        ?? new List<MaleFashion.Application.Features.Carts.Query.CartItemViewModel>();


    // =========================================================
    // CART QUANTITY
    // =========================================================

    var cartQuantity =
        cartItems.Sum(x => x.Quantity);


    // =========================================================
    // SUBTOTAL
    // =========================================================

    var cartSubtotal =
        Model?.Subtotal ?? 0m;


    // =========================================================
    // DISCOUNT PERCENTAGE
    // =========================================================

    var discountPercentage =
        Model?.Discount ?? 0m;


    // =========================================================
    // ACTUAL DISCOUNT AMOUNT
    // =========================================================

    var cartDiscount =
        cartSubtotal * discountPercentage / 100m;


    // =========================================================
    // FINAL TOTAL
    // =========================================================

    var cartTotal =
        Math.Max(
            0m,
            cartSubtotal - cartDiscount);


    // =========================================================
    // COUPON CODE

    // =========================================================

    var couponCode =
        Model?.CouponCode ?? string.Empty;


   
    // =========================================================
    // COUPON Name

    // =========================================================

    var couponName =
        Model?.CouponName ?? string.Empty;
}

<!DOCTYPE html>

<html lang="zxx">

<head>

    <meta charset="UTF-8">

    <meta name="description"
          content="Male Fashion Checkout">

    <meta name="keywords"
          content="Male_Fashion, Checkout, Payment">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta http-equiv="X-UA-Compatible"
          content="ie=edge">

    <title>Male-Fashion | Checkout</title>


    <!-- =========================================================
         GOOGLE FONT
    ========================================================= -->

    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
          rel="stylesheet">


    <!-- =========================================================
         CSS
    ========================================================= -->

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/bootstrap.min.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/font-awesome.min.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/elegant-icons.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/magnific-popup.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/nice-select.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/owl.carousel.min.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/slicknav.min.css"
          type="text/css">

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/style.css"
          type="text/css">


    <!-- =========================================================
         CUSTOM CHECKOUT CSS
    ========================================================= -->

    <style>

            /* =========================================================
                                   CHECKOUT
                                ========================================================= */

            .checkout {
                padding-top: 80px;
                padding-bottom: 80px;
            }


            /* =========================================================
                                   CHECKOUT FORM
                                ========================================================= */

            .checkout__form {
                margin-bottom: 30px;
            }


            .checkout__title {
                color: #111;
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 30px;
            }


            .checkout__input {
                margin-bottom: 20px;
            }


                .checkout__input p {
                    color: #111;
                    margin-bottom: 8px;
                    font-weight: 600;
                }


                    .checkout__input p span {
                        color: #e53637;
                    }


                .checkout__input input,
                .checkout__input textarea {
                    width: 100%;
                    border: 1px solid #e1e1e1;
                    height: 50px;
                    padding-left: 20px;
                    font-size: 14px;
                    color: #666;
                    background: #fff;
                }


                .checkout__input textarea {
                    height: 120px;
                    padding-top: 15px;
                    resize: vertical;
                }


                    .checkout__input input:focus,
                    .checkout__input textarea:focus {
                        border-color: #111;
                        outline: none;
                    }


            /* =========================================================
                                   ACTIVE COUPON BANNER
                                ========================================================= */

            .mf-coupon-banner {
                background: #f7f7f7;
                border-left: 4px solid #111;
                padding: 15px 20px;
                margin-bottom: 30px;
            }


                .mf-coupon-banner h6 {
                    margin: 0;
                    color: #111;
                    font-size: 14px;
                    font-weight: 600;
                    line-height: 1.6;
                }


                .mf-coupon-banner strong {
                    font-weight: 800;
                }


            .coupon-icon {
                margin-right: 8px;
                font-size: 16px;
            }


            /* =========================================================
                                   ORDER SUMMARY
                                ========================================================= */

            .checkout__order {
                background: #f7f7f7;
                padding: 30px;
            }


                .checkout__order h4 {
                    color: #111;
                    font-weight: 700;
                    margin-bottom: 25px;
                }


            .checkout__order__products {
                border-bottom: 1px solid #ddd;
                padding-bottom: 10px;
                margin-bottom: 15px;
            }


                .checkout__order__products li {
                    list-style: none;
                    display: flex;
                    justify-content: space-between;
                    margin-bottom: 12px;
                    font-size: 14px;
                }


                    .checkout__order__products li.product-header {
                        font-weight: 700;
                        margin-bottom: 20px;
                    }


                    .checkout__order__products li span {
                        font-weight: 600;
                    }


            .checkout__order__subtotal,
            .checkout__order__discount,
            .checkout__order__total {
                list-style: none;
                display: flex;
                justify-content: space-between;
                margin-bottom: 15px;
            }


            .checkout__order__discount {
                color: #333;
            }


            .checkout__order__total {
                border-top: 1px solid #ddd;
                padding-top: 15px;
                font-size: 18px;
                font-weight: 700;
            }


            /* =========================================================
                                   APPLY DISCOUNT BUTTON
                                ========================================================= */

            .apply-discount-wrapper {
                display: flex;
                justify-content: flex-end;
                margin-bottom: 20px;
            }


            .apply-discount-btn {
                border: none;
                cursor: pointer;
                padding: 10px 20px;
                background: #111;
                color: #fff;
                font-size: 13px;
                font-weight: 700;
                transition: 0.2s;
            }


                .apply-discount-btn:hover {
                    background: #333;
                }


                .apply-discount-btn:disabled {
                    cursor: not-allowed;
                    opacity: 0.6;
                }


            /* =========================================================
                                   DISCOUNT AMOUNT
                                ========================================================= */

            .discount-amount-row {
                display: none;
            }


                .discount-amount-row.show {
                    display: flex;
                }


            .discount-value {
                font-weight: 700;
            }


            /* =========================================================
                                   PRODUCT
                                ========================================================= */

            .checkout-product {
                display: flex;
                align-items: center;
                gap: 12px;
            }


            .checkout-product-image {
                width: 55px;
                height: 65px;
                background: #fff;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }


                .checkout-product-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }


            .checkout-product-details {
                flex: 1;
            }


                .checkout-product-details h6 {
                    margin: 0 0 4px 0;
                    font-size: 14px;
                    font-weight: 700;
                }


                .checkout-product-details span {
                    display: block;
                    font-size: 12px;
                    color: #777;
                }


            /* =========================================================
                                   PAYMENT METHOD
                                ========================================================= */

            .payment-section {
                margin-top: 30px;
                margin-bottom: 25px;
            }


                .payment-section h5 {
                    font-size: 18px;
                    font-weight: 700;
                    margin-bottom: 20px;
                    color: #111;
                }


            .payment-option {
                border: 1px solid #ddd;
                background: #fff;
                padding: 15px 18px;
                margin-bottom: 12px;
                cursor: pointer;
                transition: 0.2s;
            }


                .payment-option:hover {
                    border-color: #111;
                }


                .payment-option.active {
                    border-color: #111;
                }


                .payment-option label {
                    display: flex;
                    align-items: center;
                    margin: 0;
                    cursor: pointer;
                    width: 100%;
                }


                .payment-option input[type="radio"] {
                    margin-right: 12px;
                }


            .payment-name {
                font-weight: 700;
                color: #111;
            }


            .payment-description {
                display: block;
                font-size: 12px;
                color: #777;
                margin-left: 27px;
                margin-top: 4px;
            }


            /* =========================================================
                                   PLACE ORDER BUTTON
                                ========================================================= */

            .place-order-btn {
                width: 100%;
                border: none;
                cursor: pointer;
                text-align: center;
                margin-top: 15px;
            }


            /* =========================================================
                                   BKASH MODAL
                                ========================================================= */

            .bkash-modal-overlay {
                display: none;
                position: fixed;
                z-index: 99999;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.65);
                align-items: center;
                justify-content: center;
            }


                .bkash-modal-overlay.show {
                    display: flex;
                }


            .bkash-modal {
                width: 430px;
                max-width: 92%;
                background: #fff;
                border-radius: 6px;
                padding: 30px;
                position: relative;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            }


            .bkash-modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }


                .bkash-modal-header h4 {
                    margin: 0;
                    font-weight: 700;
                    color: #111;
                }


            .bkash-close {
                border: none;
                background: transparent;
                font-size: 25px;
                cursor: pointer;
                color: #111;
            }


            .bkash-logo {
                text-align: center;
                margin-bottom: 25px;
            }


                .bkash-logo span {
                    display: inline-block;
                    padding: 10px 25px;
                    background: #e2136e;
                    color: #fff;
                    font-weight: 800;
                    font-size: 20px;
                    border-radius: 4px;
                }


            .bkash-amount {
                background: #f7f7f7;
                padding: 18px;
                text-align: center;
                margin-bottom: 25px;
            }


                .bkash-amount small {
                    display: block;
                    color: #777;
                    margin-bottom: 5px;
                }


                .bkash-amount strong {
                    font-size: 25px;
                    color: #111;
                }


            .bkash-info {
                font-size: 13px;
                color: #777;
                text-align: center;
                margin-bottom: 20px;
            }


            .bkash-pay-btn {
                width: 100%;
                border: none;
                background: #e2136e;
                color: #fff;
                padding: 13px;
                font-weight: 700;
                cursor: pointer;
                margin-bottom: 10px;
            }


                .bkash-pay-btn:hover {
                    opacity: 0.9;
                }


            .bkash-cancel-btn {
                width: 100%;
                border: 1px solid #ddd;
                background: #fff;
                color: #111;
                padding: 13px;
                font-weight: 600;
                cursor: pointer;
            }


            /* =========================================================
                                   TOAST
                                ========================================================= */

            .checkout-toast {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 999999;
                display: none;
                padding: 14px 22px;
                color: #fff;
                background: #111;
                border-radius: 4px;
            }


                .checkout-toast.error {
                    background: #dc3545;
                }


            /* =========================================================
                                   RESPONSIVE
                                ========================================================= */

            @@media (max-width: 991px) {

                .checkout__order {
                    margin-top: 40px;
                }
            }


            @@media (max-width: 767px) {

                .mf-coupon-banner h6 {
                    font-size: 13px;
                }

                .apply-discount-wrapper {
                    justify-content: flex-start;
                }

                .apply-discount-btn {
                    width: 100%;
                }
            }

    </style>

</head>


<body>


    <!-- =========================================================
         PRELOADER
    ========================================================= -->

    <div id="preloder">

        <div class="loader"></div>

    </div>


    <!-- =========================================================
         OFFCANVAS
    ========================================================= -->

    <div class="offcanvas-menu-overlay"></div>


    <div class="offcanvas-menu-wrapper">

        <div class="offcanvas__option">

            <div class="offcanvas__links">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>
                        Hello, @User.Identity?.Name
                    </span>

                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })"
                          method="post"
                          style="display:inline-block; margin-left:15px;">

                        <button type="submit"
                                class="btn btn-link p-0"
                                style="color:#fff; text-decoration:none;">

                            Logout

                        </button>

                    </form>
                }
                else
                {
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Register">

                        Sign in

                    </a>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Faq">

                        FAQs

                    </a>
                }

            </div>

        </div>


        <div class="offcanvas__nav__option">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Wishlist"
                   class="wishlist-button"
                   title="My Wishlist">

                    <img src="~/Malefashon/Assets/img/icon/heart.png"
                         alt="Wishlist">

                    <span>
                        @await Component.InvokeAsync("WishlistCount")
                    </span>

                </a>
            }


            @await Component.InvokeAsync("CartSummary")

        </div>


        <div id="mobile-menu-wrap"></div>


        <div class="offcanvas__text">

            <p>
                Free shipping, 30-day return or refund guarantee.
            </p>

        </div>

    </div>


    <!-- =========================================================
         HEADER
    ========================================================= -->

    <header class="header">

        <div class="header__top">

            <div class="container">

                <div class="row">

                    <div class="col-lg-6 col-md-7">

                        <div class="header__top__left">

                            <p>
                                Free shipping, 30-day return or refund guarantee.
                            </p>

                        </div>

                    </div>


                    <div class="col-lg-6 col-md-5">

                        <div class="header__top__right">

                            <div class="header__top__links">

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <div style="
                                        display:flex;
                                        align-items:center;
                                        gap:15px;
                                        margin-right:30px;">

                                        <span style="
                                            color:#fff;
                                            background:#000;
                                            padding:8px 15px;
                                            border-radius:4px;
                                            font-weight:600;
                                            white-space:nowrap;">

                                            Hello, @User.Identity?.Name

                                        </span>


                                        <a asp-area="Customer"
                                           asp-controller="Account"
                                           asp-action="ChangePassword"
                                           style="
                                            color:#fff;
                                            text-decoration:none;
                                            font-weight:600;
                                            white-space:nowrap;">

                                            Change Password

                                        </a>


                                        <form asp-area=""
                                              asp-controller="Account"
                                              asp-action="Logout"
                                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })"
                                              method="post"
                                              style="margin:0;">

                                            <button type="submit"
                                                    class="btn btn-link p-0"
                                                    style="
                                                color:#fff;
                                                text-decoration:none;
                                                font-weight:600;
                                                border:none;
                                                background:transparent;">

                                                Logout

                                            </button>

                                        </form>

                                    </div>
                                }
                                else
                                {
                                    <div class="offcanvas__links">

                                        <a asp-area=""
                                           asp-controller="Account"
                                           asp-action="Register">

                                            Sign in

                                        </a>

                                        <a asp-area=""
                                           asp-controller="Home"
                                           asp-action="Faq">

                                            FAQs

                                        </a>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN HEADER
        ====================================================== -->

        <div class="container">

            <div class="row">

                <!-- LOGO -->

                <div class="col-lg-3 col-md-3">

                    <div class="header__logo">

                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Index">

                            <img src="~/Malefashon/Assets/img/logo.png"
                                 alt="Male Fashion">

                        </a>

                    </div>

                </div>


                <!-- NAVIGATION -->

                <div class="col-lg-6 col-md-6">

                    <nav class="header__menu mobile-menu">

                        <ul>

                            <li>

                                <a asp-area="Customer"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Home

                                </a>

                            </li>


                            <li>

                                <a asp-area="Customer"
                                   asp-controller="Home"
                                   asp-action="Shop">

                                    Shop

                                </a>

                            </li>


                            <li class="active">

                                <a href="#">

                                    My Shopping

                                </a>

                                <ul class="dropdown">

                                    <li>

                                        <a asp-area="Customer"
                                           asp-controller="Home"
                                           asp-action="ShopDetails">

                                            Shop Details

                                        </a>

                                    </li>


                                    <li>

                                        <a asp-area="Customer"
                                           asp-controller="Home"
                                           asp-action="Shoppingcart">

                                            Shopping Cart

                                        </a>

                                    </li>


                                    <li class="active">

                                        <a asp-area="Customer"
                                           asp-controller="Home"
                                           asp-action="Checkout">

                                            Check Out

                                        </a>

                                    </li>

                                    <li>

                                        <a asp-area="Customer"
                                           asp-controller="Home"
                                           asp-action="OrderHistory">
                                            Order History
                                        </a>

                                    </li>

                                </ul>

                            </li>


                            @if (User.Identity?.IsAuthenticated == false)
                            {
                                <li>

                                    <a asp-area="Customer"
                                       asp-controller="Home"
                                       asp-action="Blog">

                                        Blog

                                    </a>

                                </li>


                                <li>

                                    <a asp-area="Customer"
                                       asp-controller="ContactUs"
                                       asp-action="Contact">

                                        Contacts

                                    </a>

                                </li>


                               
                            }

                        </ul>

                    </nav>

                </div>


                <!-- HEADER ICONS -->

                <div class="col-lg-3 col-md-3">

                    <div class="header__nav__option">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Wishlist"
                               class="wishlist-button"
                               title="My Wishlist">

                                <img src="~/Malefashon/Assets/img/icon/heart.png"
                                     alt="Wishlist">

                                <span style="
                                    font-size:14px;
                                    color:#111;
                                    font-weight:normal;">

                                    @await Component.InvokeAsync("WishlistCount")

                                </span>

                            </a>
                        }


                        <!-- CART -->

                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Shoppingcart"
                           title="Shopping Cart">

                            <img src="~/Malefashon/Assets/img/icon/cart.png"
                                 alt="Cart">

                            <span id="headerCartQuantity">

                                @cartQuantity

                            </span>

                        </a>


                        <!-- CART TOTAL -->

                        <div class="price"
                             id="headerCartTotal">

                            ৳@cartTotal.ToString("N2")

                        </div>

                    </div>

                </div>

            </div>


            <div class="canvas__open">

                <i class="fa fa-bars"></i>

            </div>

        </div>

    </header>


    <!-- =========================================================
         BREADCRUMB
    ========================================================= -->

    <section class="breadcrumb-option">

        <div class="container">

            <div class="row">

                <div class="col-lg-12">

                    <div class="breadcrumb__text">

                        <h4>
                            Checkout
                        </h4>

                        <div class="breadcrumb__links">

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Shoppingcart">

                                Shopping Cart

                            </a>

                            <span>
                                Checkout
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CHECKOUT
    ========================================================= -->

    <section class="checkout">

        <div class="container">

            @if (!cartItems.Any())
            {
                <!-- =================================================
                     EMPTY CART
                ================================================= -->

                <div class="text-center"
                     style="padding:80px 20px;">

                    <h4>
                        Your shopping cart is empty.
                    </h4>

                    <p>
                        Add products to your cart before checkout.
                    </p>

                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Shop"
                       class="primary-btn">

                        START SHOPPING

                    </a>

                </div>
            }
            else
            {
                <!-- =================================================
                     ACTIVE COUPON BANNER
                ================================================= -->
                @if (!string.IsNullOrWhiteSpace(couponCode))
                {
                    <div class="mf-coupon-banner">

                        <h6>

                            <span class="icon_tag_alt coupon-icon"></span>

                            <strong>
                                @couponName
                            </strong>

                            &nbsp;|&nbsp;

                            You save

                            <strong>
                                @discountPercentage.ToString("0.##")%
                            </strong>

                            on this order.

                        </h6>

                    </div>
                }
                else
                {
                    <div class="mf-coupon-banner">

                        <h6>

                            <span class="icon_tag_alt coupon-icon"></span>

                            No active coupon is available at the moment.

                        </h6>

                    </div>
                }


                <!-- =================================================
                     CHECKOUT FORM
                ================================================= -->

                <form asp-area="Customer"
                      asp-controller="Home"
                      asp-action="PlaceOrder"
                      method="post"
                      id="checkoutForm">

                    @Html.AntiForgeryToken()


                    <div class="row">


                        <!-- =================================================
                             CUSTOMER INFORMATION
                        ================================================= -->

                        <div class="col-lg-7">

                            <div class="checkout__form">

                                <h4 class="checkout__title">
                                    Billing Details
                                </h4>


                               
                                <input type="hidden"
                                       name="CouponCode"
                                       value="@couponCode" />

                                <input type="hidden"
                                       name="MobileNumber"
                                       id="mobileNumberHidden">

                                <input type="hidden"
                                       name="TransactionId"
                                       id="transactionIdHidden">


                                <!-- PHONE -->

                                <div class="checkout__input">

                                    <p>
                                        Phone
                                        <span>*</span>
                                    </p>

                                    <input type="text"
                                           name="Phone"
                                           placeholder="01XXXXXXXXX"
                                           required>

                                </div>


                                <!-- ADDRESS -->

                                <div class="checkout__input">

                                    <p>
                                        Address
                                        <span>*</span>
                                    </p>

                                    <input type="text"
                                           name="Address"
                                           placeholder="Street Address"
                                           required>

                                </div>


                                <!-- CITY -->

                                <div class="checkout__input">

                                    <p>
                                        Town / City
                                        <span>*</span>
                                    </p>

                                    <input type="text"
                                           name="TownCity"
                                           placeholder="Town / City"
                                           required>

                                </div>


                                <!-- STATE -->

                                <div class="checkout__input">

                                    <p>
                                        State / Country
                                        <span>*</span>
                                    </p>

                                    <input type="text"
                                           name="CountryState"
                                           placeholder="State / Country"
                                           required>

                                </div>


                                <!-- POSTCODE -->

                                <div class="checkout__input">

                                    <p>
                                        Postcode / ZIP
                                        <span>*</span>
                                    </p>

                                    <input type="text"
                                           name="PostcodeZip"
                                           placeholder="Postcode / ZIP"
                                           required>

                                </div>


                                <!-- ORDER NOTES -->

                                <div class="checkout__input">

                                    <p>
                                        Order Notes
                                    </p>

                                    <textarea name="OrderNotes"
                                              placeholder="Notes about your order, e.g. special delivery instructions."></textarea>

                                </div>

                            </div>

