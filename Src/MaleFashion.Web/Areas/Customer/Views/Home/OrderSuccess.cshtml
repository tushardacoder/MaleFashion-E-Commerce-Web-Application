
@{
    ViewData["Title"] = "Order Successful";
}

<!-- ========================================================= -->
<!-- BREADCRUMB SECTION -->
<!-- ========================================================= -->

<section class="breadcrumb-option">

    <div class="container">

        <div class="row">

            <div class="col-lg-12">

                <div class="breadcrumb__text">

                    @* <h4>
                        Order Successful
                    </h4>

                    <div class="breadcrumb__links">

                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                        <span>
                            Order Successful
                        </span> *@

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- ORDER SUCCESS SECTION -->
<!-- ========================================================= -->

<section class="checkout spad">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8 col-md-10">

                <div class="order-success-box">

                    <!-- ================================================= -->
                    <!-- SUCCESS ICON -->
                    <!-- ================================================= -->

                    <div class="success-icon">
                        ✓
                    </div>


                    <!-- ================================================= -->
                    <!-- SUCCESS TITLE -->
                    <!-- ================================================= -->

                    <h2>
                        Order Placed Successfully!
                    </h2>


                    <!-- ================================================= -->
                    <!-- MESSAGE -->
                    <!-- ================================================= -->

                    <p class="success-message">

                        Thank you for shopping with
                        <strong>Male Fashion</strong>.

                    </p>


                    <!-- ================================================= -->
                    <!-- ORDER ID -->
                    <!-- ================================================= -->

                    <div class="order-id-box">

                        <span>
                            Order ID
                        </span>

                        <strong>
                            @ViewBag.OrderId
                        </strong>

                    </div>


                    <!-- ================================================= -->
                    <!-- DESCRIPTION -->
                    <!-- ================================================= -->

                    <p class="success-description">

                        Your order has been successfully received.
                        We will process your order and prepare it
                        for delivery.

                    </p>


                    <!-- ================================================= -->
                    <!-- BUTTONS -->
                    <!-- ================================================= -->

                    <div class="success-buttons">

                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Shop"
                           class="secondary-btn">

                            CONTINUE SHOPPING

                        </a>


                        @* <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Index"
                           class="secondary-btn">

                            BACK TO HOME

                        </a> *@

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- CUSTOM ORDER SUCCESS CSS -->
<!-- ========================================================= -->

<style>

    /* =========================================================
           ORDER SUCCESS BOX
           ========================================================= */

    .order-success-box {
        background: #ffffff;
        text-align: center;
        padding: 65px 45px;
        margin-bottom: 50px;
        border: 1px solid #ebebeb;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
    }


    /* =========================================================
           SUCCESS ICON
           ========================================================= */

    .success-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #111111;
        display: flex;
        align-items: center;
        justify-content: center;
    }


        .success-icon i {
            color: #ffffff;
            font-size: 42px;
        }


    /* =========================================================
           TITLE
           ========================================================= */

    .order-success-box h2 {
        font-size: 30px;
        font-weight: 700;
        color: #111111;
        margin-bottom: 15px;
    }


    /* =========================================================
           SUCCESS MESSAGE
           ========================================================= */

    .success-message {
        color: #777777;
        font-size: 16px;
        margin-bottom: 25px;
    }


        .success-message strong {
            color: #111111;
        }


    /* =========================================================
           ORDER ID
           ========================================================= */

    .order-id-box {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: #f7f7f7;
        padding: 15px 25px;
        margin-bottom: 25px;
        border-left: 3px solid #111111;
    }


        .order-id-box span {
            color: #777777;
            font-size: 14px;
        }


        .order-id-box strong {
            color: #111111;
            font-size: 15px;
        }


    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .success-description {
        max-width: 600px;
        margin: 0 auto 30px;
        color: #777777;
        font-size: 14px;
        line-height: 1.8;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .success-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }


        .success-buttons .primary-btn {
            display: inline-block;
        }


    .secondary-btn {
        display: inline-block;
        padding: 14px 30px;
        background: #111111;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s ease;
    }


        .secondary-btn:hover {
            background: #333333;
            color: #ffffff;
            text-decoration: none;
        }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        .order-success-box {
            padding: 45px 20px;
        }


            .order-success-box h2 {
                font-size: 24px;
            }


        .success-icon {
            width: 75px;
            height: 75px;
        }


            .success-icon i {
                font-size: 34px;
            }


        .order-id-box {
            flex-direction: column;
            gap: 5px;
        }


        .success-buttons {
            flex-direction: column;
        }


            .success-buttons .primary-btn,
            .secondary-btn {
                width: 100%;
                text-align: center;
            }
    }



    .success-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: #28a745;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 20px;
    }

</style>

