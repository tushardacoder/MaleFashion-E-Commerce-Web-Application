    <!-- ========================================================= -->
    <!-- SHOP JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>

            // ==========================================================
            // SIZE FILTER
            // ==========================================================

            function filterBySize(element) {

                const url =
                    new URL(window.location.href);


                if (element.checked) {

                    url.searchParams.set(
                        "size",
                        element.value
                    );

                }
                else {

                    url.searchParams.delete(
                        "size"
                    );

                }


                url.searchParams.set(
                    "page",
                    "1"
                );


                window.location.href =
                    url.toString();

            }


            // ==========================================================
            // COLOR FILTER
            // ==========================================================

            function filterByColor(element) {

                const url =
                    new URL(window.location.href);


                if (element.checked) {

                    url.searchParams.set(
                        "color",
                        element.value
                    );

                }
                else {

                    url.searchParams.delete(
                        "color"
                    );

                }


                url.searchParams.set(
                    "page",
                    "1"
                );


                window.location.href =
                    url.toString();

            }


            // ==========================================================
            // SORT
            // ==========================================================

            function sortProducts() {

                const select =
                    document.getElementById(
                        "sortProducts"
                    );


                const url =
                    new URL(window.location.href);


                const sort =
                    select.value;


                if (sort === "default") {

                    url.searchParams.delete(
                        "sort"
                    );

                }
                else {

                    url.searchParams.set(
                        "sort",
                        sort
                    );

                }


                url.searchParams.set(
                    "page",
                    "1"
                );


                window.location.href =
                    url.toString();

            }


            // ==========================================================
            // PRODUCT IMAGE SLIDER
            // ==========================================================

            $(document).ready(function() {


                $('.product-slider').each(function() {


                    $(this).slick({

                        slidesToShow: 1,

                        slidesToScroll: 1,

                        arrows: true,

                        dots: true,

                        infinite: true,

                        autoplay: true,

                        autoplaySpeed: 3000,

                        speed: 500,

                        pauseOnHover: true,

                        adaptiveHeight: false

                    });


                });


            });

    </script>

</body>

