@functions
{
    string GetColorClass(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
            return "c-1";

        return color.Trim().ToLowerInvariant() switch
        {
            "black" => "black",
            "grey" => "c-2",
            "gray" => "c-2",
            "red" => "c-3",
            "white" => "c-4",
            "blue" => "c-5",
            "green" => "c-6",
            "yellow" => "c-7",
            "brown" => "c-8",
            "orange" => "c-9",
            _ => "c-1"
        };
    }
}

