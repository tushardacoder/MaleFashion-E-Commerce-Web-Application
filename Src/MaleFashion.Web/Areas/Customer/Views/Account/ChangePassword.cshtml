@using MaleFashion.Web.Models.Account
@using Microsoft.Extensions.Configuration

@model ChangePasswordModel

@inject IConfiguration Configuration

@{
    var recaptchaSiteKey =
        Configuration["GoogleReCaptcha:SiteKey"];

    ViewData["Title"] = "Change Password";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Male Fashion | Change Password</title>


    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
          rel="stylesheet">


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/bootstrap.min.css">


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/font-awesome.min.css">


    <!-- Main CSS -->

    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/style.css">


    <!-- Google reCAPTCHA v3 -->

    <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>


    <style>

            body {
                background: #f5f5f5;
                font-family: "Nunito Sans", sans-serif;
            }


            .change-password-section {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 15px;
            }


            .change-password-box {
                background: #fff;
                width: min(100%, 550px);
                padding: clamp(25px, 5vw, 45px);
                box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
            }


            .change-password-logo {
                text-align: center;
                margin-bottom: 30px;
            }


                .change-password-logo img {
                    max-width: 180px;
                }


            .change-password-title {
                text-align: center;
                margin-bottom: 30px;
            }


                .change-password-title h2 {
                    font-size: clamp(22px, 5vw, 28px);
                    font-weight: 700;
                    margin-bottom: 8px;
                }


                .change-password-title p {
                    color: #777;
                    font-size: clamp(13px, 2vw, 16px);
                    margin-bottom: 0;
                }


            .form-group {
                margin-bottom: 20px;
            }


                .form-group label {
                    display: block;
                    font-weight: 600;
                    margin-bottom: 8px;
                }


            .form-control {
                width: 100%;
                height: 50px;
                border: 1px solid #ddd;
                border-radius: 0;
                padding: 0 15px;
            }


                .form-control:focus {
                    border-color: #111;
                    box-shadow: none;
                }


            .change-password-btn {
                width: 100%;
                height: 50px;
                border: none;
                background: #111;
                color: #fff;
                font-weight: 700;
                text-transform: uppercase;
                cursor: pointer;
                transition: 0.3s;
            }


                .change-password-btn:hover {
                    background: #333;
                }


                .change-password-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }


            .validation-error {
                display: block;
                margin-top: 6px;
                color: #dc3545;
                font-size: 13px;
            }


            .validation-summary {
                margin-bottom: 20px;
                color: #dc3545;
                font-size: 14px;
            }


            .success-message {
                margin-bottom: 20px;
            }


            .back-link {
                text-align: center;
                margin-top: 25px;
            }


                .back-link a {
                    color: #111;
                    font-weight: 600;
                    text-decoration: none;
                }


                    .back-link a:hover {
                        text-decoration: underline;
                    }


            .home-link {
                text-align: center;
                margin-top: 20px;
            }


                .home-link a {
                    color: #555;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }


                    .home-link a:hover {
                        color: #111;
                        text-decoration: underline;
                    }

    </style>

</head>


<body>


    <section class="change-password-section">

        <div class="change-password-box">


            <!-- Logo -->

            <div class="change-password-logo">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index1">

                    <img src="~/Malefashon/Assets/img/logo.png"
                         alt="Male Fashion">

                </a>

            </div>


            <!-- Title -->

            <div class="change-password-title">

                <h2>Change Password</h2>

                <p>
                    Update your account password securely.
                </p>

            </div>


            <!-- Success Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success success-message">

                    @TempData["SuccessMessage"]

                </div>
            }


            <!-- Change Password Form -->

            <form id="changePasswordForm"
                  method="post"
                  asp-area="Customer"
                  asp-controller="Account"
                  asp-action="ChangePassword">

                @Html.AntiForgeryToken()


                <!-- reCAPTCHA Token -->

                <input type="hidden"
                       id="recaptchaToken"
                       name="recaptchaToken" />


                <!-- Validation Summary -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"
                     role="alert">
                </div>


                <!-- Current Password -->

                <div class="form-group">

                    <label asp-for="CurrentPassword">
                        Current Password
                    </label>

                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Enter your current password" />

                    <span asp-validation-for="CurrentPassword"
                          class="validation-error">
                    </span>

                </div>


                <!-- New Password -->

                <div class="form-group">

                    <label asp-for="NewPassword">
                        New Password
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Enter your new password" />

                    <span asp-validation-for="NewPassword"
                          class="validation-error">
                    </span>

                </div>


                <!-- Confirm New Password -->

                <div class="form-group">

                    <label asp-for="ConfirmNewPassword">
                        Confirm New Password
                    </label>

                    <input asp-for="ConfirmNewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm your new password" />

                    <span asp-validation-for="ConfirmNewPassword"
                          class="validation-error">
                    </span>

                </div>


                <!-- Change Password Button -->

                <button id="changePasswordSubmit"
                        type="submit"
                        class="change-password-btn">

                    Change Password

                </button>


            </form>


            <!-- Back to Home -->

            <div class="home-link">

                <a asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="fa fa-arrow-left"></i>

                    Back to Home

                </a>

            </div>


        </div>

    </section>


    <!-- Scripts -->

    <script src="~/Malefashon/Assets/js/jquery-3.3.1.min.js"></script>

    <script src="~/Malefashon/Assets/js/bootstrap.min.js"></script>


    <!-- ASP.NET Core Validation -->

    <partial name="_ValidationScriptsPartial" />


    <!-- Google reCAPTCHA v3 -->

    <script>

            const changePasswordForm =
                document.getElementById("changePasswordForm");


            const changePasswordButton =
                document.getElementById("changePasswordSubmit");


            changePasswordForm.addEventListener(
                "submit",
                function(event) {

                    // If token already exists,
                    // allow normal form submission

                    const token =
                        document
                            .getElementById("recaptchaToken")
                            .value;


                    if (token) {
                        return;
                    }


                    // Stop submission until
                    // reCAPTCHA token is generated

                    event.preventDefault();


                    // Prevent multiple clicks

                    changePasswordButton.disabled = true;


                    grecaptcha.ready(function() {

                        grecaptcha.execute(
                            '@recaptchaSiteKey',
                            {
                                action: 'change_password'
                            }
                        )
                            .then(function(token) {

                                document
                                    .getElementById("recaptchaToken")
                                    .value = token;


                                // Submit normally

                                changePasswordForm.submit();

                            })
                            .catch(function(error) {

                                console.error(error);

                                changePasswordButton.disabled = false;

                                alert(
                                    "Security verification failed. Please try again."
                                );

                            });

                    });

                });

    </script>


</body>

</html>