{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {

    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      //"Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "WriteTo": [


      {
        "Name": "File",
        "Args": {
          "path": "Logs/web-log-.txt",
          "rollingInterval": "Day"
        }
      },

