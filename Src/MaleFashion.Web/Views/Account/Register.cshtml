@using MaleFashion.Web.Models.Account
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration

@{
    var recaptchaSiteKey =
        Configuration["GoogleReCaptcha:SiteKey"];
}

@model RegisterModel

@{
    Layout = null;
    ViewData["Title"] = "Sign Up";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Male Fashion | Sign Up</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/font-awesome.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/style.css">

    <!-- Google reCAPTCHA v3 -->
    <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>

    <style>

            body {
                background: #f5f5f5;
            }

            .signup-section {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 15px;
            }

            .signup-box {
                background: #fff;
                width: min(100%, 550px);
                padding: clamp(25px, 5vw, 45px);
                box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
            }

            .signup-logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .signup-logo img {
                    max-width: 180px;
                }

            .signup-title {
                text-align: center;
                margin-bottom: 30px;
            }

                .signup-title h2 {
                    font-size: clamp(22px, 5vw, 28px);
                    font-weight: 700;
                    margin-bottom: 8px;
                }

                .signup-title p {
                    font-size: clamp(13px, 2vw, 16px);
                    color: #777;
                    margin-bottom: 0;
                }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    font-weight: 600;
                    margin-bottom: 8px;
                }

            .form-control {
                width: 100%;
                height: 50px;
                border: 1px solid #ddd;
                border-radius: 0;
                padding: 0 15px;
            }

                .form-control:focus {
                    border-color: #111;
                    box-shadow: none;
                }

            .signup-btn {
                width: 100%;
                height: 50px;
                border: none;
                background: #111;
                color: #fff;
                font-weight: 700;
                text-transform: uppercase;
                cursor: pointer;
            }

                .signup-btn:hover {
                    background: #333;
                }

                .signup-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }

            .validation-error {
                display: block;
                margin-top: 6px;
                color: #dc3545;
                font-size: 13px;
            }

            .validation-summary {
                margin-bottom: 20px;
                color: #dc3545;
                font-size: 14px;
            }

            .login-link {
                text-align: center;
                margin-top: 25px;
            }

                .login-link a {
                    color: #111;
                    font-weight: 700;
                    text-decoration: underline;
                }

            .home-link {
                text-align: center;
                margin-top: 20px;
            }

                .home-link a {
                    color: #555;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .home-link a:hover {
                        color: #111;
                        text-decoration: underline;
                    }

    </style>

</head>

<body>

    <section class="signup-section">

        <div class="signup-box">

            <!-- Logo -->
            <div class="signup-logo">

                <a asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/Malefashon/Assets/img/logo.png"
                         alt="Male Fashion">

                </a>

            </div>


            <!-- Title -->
            <div class="signup-title">

                <h2>Create Account</h2>

                <p>
                    Sign up to create your Male Fashion account
                </p>

            </div>


            <!-- Register Form -->
            <form id="registerForm"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- reCAPTCHA Token -->
                <input type="hidden"
                       id="recaptchaToken"
                       name="recaptchaToken" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"
                     role="alert">
                </div>


                <!-- Email -->
                <div class="form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="Enter your email">

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>


                <!-- First Name -->
                <div class="form-group">

                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <input asp-for="FirstName"
                           class="form-control"
                           autocomplete="given-name"
                           aria-required="true"
                           placeholder="Enter your first name">

                    <span asp-validation-for="FirstName"
                          class="validation-error">
                    </span>

                </div>


                <!-- Last Name -->
                <div class="form-group">

                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           autocomplete="family-name"
                           aria-required="true"
                           placeholder="Enter your last name">

                    <span asp-validation-for="LastName"
                          class="validation-error">
                    </span>

                </div>


                <!-- Date of Birth -->
                <div class="form-group">

                    <label asp-for="DateOfBirth">
                        Date of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-control"
                           autocomplete="bday"
                           aria-required="true">

                    <span asp-validation-for="DateOfBirth"
                          class="validation-error">
                    </span>

                </div>


                <!-- Password -->
                <div class="form-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Enter your password">

                    <span asp-validation-for="Password"
                          class="validation-error">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm your password">

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-error">
                    </span>

                </div>


                <!-- Register -->
                <button id="registerSubmit"
                        type="submit"
                        class="signup-btn">

                    Create Account

                </button>

            </form>


            <!-- Sign In -->
            <div class="login-link">

                Already have an account?

                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Login">

                    Sign In

                </a>

            </div>


            <!-- Home -->
            <div class="home-link">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index1">

                    <i class="fa fa-arrow-left"></i>

                    Back to Home

                </a>

            </div>

        </div>

    </section>


    <!-- Scripts -->

    <script src="~/Malefashon/Assets/js/jquery-3.3.1.min.js"></script>

    <script src="~/Malefashon/Assets/js/bootstrap.min.js"></script>

    <!-- Validation -->
    <partial name="_ValidationScriptsPartial" />


    <!-- Google reCAPTCHA v3 -->
    <script>

            const registerForm =
                document.getElementById("registerForm");

            const registerButton =
                document.getElementById("registerSubmit");

            registerForm.addEventListener(
                "submit",
                function(event) {

                    // Stop normal form submission first
                    event.preventDefault();

                    // Disable button to prevent multiple clicks
                    registerButton.disabled = true;

                    grecaptcha.ready(function() {

                        grecaptcha.execute(
                            '@recaptchaSiteKey',
                            {
                                action: 'signup'
                            }
                        )
                            .then(function(token) {

                                document
                                    .getElementById("recaptchaToken")
                                    .value = token;

                                // Submit form after receiving token
                                registerForm.submit();

                            })
                            .catch(function(error) {

                                console.error("reCAPTCHA error:", error);

                                registerButton.disabled = false;

                                alert("reCAPTCHA failed. Check the browser console.");
                            });

                    });

                });

    </script>

</body>

</html>