@using MaleFashion.Web.Models.Account
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration

@{
    var recaptchaSiteKey =
        Configuration["GoogleReCaptcha:SiteKey"];
}

@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Male Fashion | Reset Password</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/font-awesome.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/style.css">

    <!-- Google reCAPTCHA v3 -->
    <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>

    <style>

            body {
                background: #f5f5f5;
                font-family: "Nunito Sans", sans-serif;
            }

            .reset-section {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 15px;
            }

            .reset-box {
                background: #fff;
                width: min(100%, 550px);
                padding: clamp(25px, 5vw, 45px);
                box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
            }

            .reset-logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .reset-logo img {
                    max-width: 180px;
                }

            .reset-title {
                text-align: center;
                margin-bottom: 30px;
            }

                .reset-title h2 {
                    font-size: clamp(22px, 5vw, 28px);
                    font-weight: 700;
                    margin-bottom: 8px;
                }

                .reset-title p {
                    color: #777;
                    font-size: 15px;
                    margin-bottom: 0;
                }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    font-weight: 600;
                    margin-bottom: 8px;
                }

            .form-control {
                width: 100%;
                height: 50px;
                border: 1px solid #ddd;
                border-radius: 0;
                padding: 0 15px;
            }

                .form-control:focus {
                    border-color: #111;
                    box-shadow: none;
                }

            .reset-btn {
                width: 100%;
                height: 50px;
                border: none;
                background: #111;
                color: #fff;
                font-weight: 700;
                text-transform: uppercase;
                cursor: pointer;
                transition: 0.3s;
            }

                .reset-btn:hover {
                    background: #333;
                }

                .reset-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }

            .validation-error {
                display: block;
                margin-top: 6px;
                color: #dc3545;
                font-size: 13px;
            }

            .validation-summary {
                margin-bottom: 20px;
                color: #dc3545;
                font-size: 14px;
            }

            .login-link {
                text-align: center;
                margin-top: 25px;
            }

                .login-link a {
                    color: #111;
                    font-weight: 700;
                    text-decoration: none;
                }

                    .login-link a:hover {
                        text-decoration: underline;
                    }

            .home-link {
                text-align: center;
                margin-top: 20px;
            }

                .home-link a {
                    color: #555;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .home-link a:hover {
                        color: #111;
                        text-decoration: underline;
                    }

    </style>

</head>

<body>

    <section class="reset-section">

        <div class="reset-box">

            <!-- Logo -->
            <div class="reset-logo">

                <a asp-controller="Home"
                   asp-action="Index1">

                    <img src="~/Malefashon/Assets/img/logo.png"
                         alt="Male Fashion">

                </a>

            </div>


            <!-- Title -->
            <div class="reset-title">

                <h2>Reset Your Password</h2>

                <p>
                    Enter your email and choose a new password.
                </p>

            </div>


            <!-- Reset Form -->
            <form id="resetPasswordForm"
                  asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- reCAPTCHA Token -->
                <input type="hidden"
                       id="recaptchaToken"
                       name="recaptchaToken" />


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"
                     role="alert">
                </div>


                <!-- Reset Code -->
                <input asp-for="Code"
                       type="hidden">


                <!-- Email -->
                <div class="form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="Enter your email">

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>


                <!-- New Password -->
                <div class="form-group">

                    <label asp-for="Password">
                        New Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Enter your new password">

                    <span asp-validation-for="Password"
                          class="validation-error">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Confirm New Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm your new password">

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-error">
                    </span>

                </div>


                <!-- Reset Button -->
                <button id="resetPasswordSubmit"
                        type="submit"
                        class="reset-btn">

                    Reset Password

                </button>

            </form>


            <!-- Login -->
            <div class="login-link">

                <a asp-controller="Account"
                   asp-action="Login">

                    <i class="fa fa-arrow-left"></i>

                    Back to Login

                </a>

            </div>


            <!-- Home -->
            <div class="home-link">

                <a asp-controller="Home"
                   asp-action="Index1">

                    <i class="fa fa-home"></i>

                    Back to Home

                </a>

            </div>

        </div>

    </section>


    <!-- Scripts -->

    <script src="~/Malefashon/Assets/js/jquery-3.3.1.min.js"></script>

    <script src="~/Malefashon/Assets/js/bootstrap.min.js"></script>


    <!-- Validation -->
    <partial name="_ValidationScriptsPartial" />


    <!-- Google reCAPTCHA v3 -->
    <script>

            const resetPasswordForm =
                document.getElementById("resetPasswordForm");

            const resetPasswordButton =
                document.getElementById("resetPasswordSubmit");


            resetPasswordForm.addEventListener(
                "submit",
                function(event) {

                    // If token already exists,
                    // allow normal form submission
                    const token =
                        document.getElementById("recaptchaToken").value;

                    if (token) {
                        return;
                    }


                    // Stop form submission
                    event.preventDefault();


                    // Prevent multiple clicks
                    resetPasswordButton.disabled = true;


                    grecaptcha.ready(function() {

                        grecaptcha.execute(
                            '@recaptchaSiteKey',
                            {
                                action: 'reset_password'
                            }
                        )
                            .then(function(token) {

                                document
                                    .getElementById("recaptchaToken")
                                    .value = token;


                                // Submit form normally
                                resetPasswordForm.submit();

                            })
                            .catch(function(error) {

                                console.error(error);

                                resetPasswordButton.disabled = false;

                                alert(
                                    "Security verification failed. Please try again."
                                );

                            });

                    });

                });

    </script>

</body>

</html>