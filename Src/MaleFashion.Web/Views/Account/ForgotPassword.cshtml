@using MaleFashion.Web.Models.Account
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration

@{
    var recaptchaSiteKey =
        Configuration["GoogleReCaptcha:SiteKey"];
}

@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Male Fashion | Forgot Password</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/font-awesome.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/Malefashon/Assets/css/style.css">

    <!-- Google reCAPTCHA v3 -->
    <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>

    <style>

            body {
                background: #f5f5f5;
                font-family: "Nunito Sans", sans-serif;
            }

            .forgot-password-section {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 15px;
            }

            .forgot-password-box {
                background: #fff;
                width: min(100%, 550px);
                padding: clamp(25px, 5vw, 45px);
                box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
            }

            .forgot-logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .forgot-logo img {
                    max-width: 180px;
                }

            .forgot-title {
                text-align: center;
                margin-bottom: 30px;
            }

                .forgot-title h2 {
                    font-size: clamp(22px, 5vw, 28px);
                    font-weight: 700;
                    margin-bottom: 8px;
                }

                .forgot-title p {
                    color: #777;
                    font-size: 15px;
                    margin-bottom: 0;
                    line-height: 1.6;
                }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    font-weight: 600;
                    margin-bottom: 8px;
                }

            .form-control {
                width: 100%;
                height: 50px;
                border: 1px solid #ddd;
                border-radius: 0;
                padding: 0 15px;
            }

                .form-control:focus {
                    border-color: #111;
                    box-shadow: none;
                }

            .reset-btn {
                width: 100%;
                height: 50px;
                border: none;
                background: #111;
                color: #fff;
                font-weight: 700;
                text-transform: uppercase;
                cursor: pointer;
                transition: 0.3s;
            }

                .reset-btn:hover {
                    background: #333;
                }

                .reset-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }

            .validation-error {
                display: block;
                margin-top: 6px;
                color: #dc3545;
                font-size: 13px;
            }

            .validation-summary {
                margin-bottom: 20px;
                color: #dc3545;
                font-size: 14px;
            }

            .login-links {
                text-align: center;
                margin-top: 25px;
            }

                .login-links a {
                    color: #111;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .login-links a:hover {
                        text-decoration: underline;
                    }

            .home-link {
                text-align: center;
                margin-top: 20px;
            }

                .home-link a {
                    color: #555;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .home-link a:hover {
                        color: #111;
                        text-decoration: underline;
                    }

    </style>

</head>

<body>

    <section class="forgot-password-section">

        <div class="forgot-password-box">

            <!-- Logo -->
            <div class="forgot-logo">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index1">

                    <img src="~/Malefashon/Assets/img/logo.png"
                         alt="Male Fashion">

                </a>

            </div>


            <!-- Title -->
            <div class="forgot-title">

                <h2>Forgot Password?</h2>

                <p>
                    Enter your email address and we will send you
                    a link to reset your password.
                </p>

            </div>


            <!-- Forgot Password Form -->
            <form id="forgotPasswordForm"
                  method="post"
                  asp-area=""
                  asp-controller="Account"
                  asp-action="ForgotPassword">

                @Html.AntiForgeryToken()

                <!-- reCAPTCHA Token -->
                <input type="hidden"
                       id="recaptchaToken"
                       name="recaptchaToken" />


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"
                     role="alert">
                </div>


                <!-- Email -->
                <div class="form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email"
                           aria-required="true"
                           placeholder="Enter your email address">

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>


                <!-- Reset Button -->
                <button id="forgotPasswordSubmit"
                        type="submit"
                        class="reset-btn">

                    Send Reset Link

                </button>

            </form>


            <!-- Back to Login -->
            <div class="login-links">

                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Login">

                    Back to Login

                </a>

            </div>


            <!-- Back to Home -->
            <div class="home-link">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index1">

                    <i class="fa fa-arrow-left"></i>

                    Back to Home

                </a>

            </div>

        </div>

    </section>


    <!-- Scripts -->

    <script src="~/Malefashon/Assets/js/jquery-3.3.1.min.js"></script>

    <script src="~/Malefashon/Assets/js/bootstrap.min.js"></script>


    <!-- Validation -->
    <partial name="_ValidationScriptsPartial" />


    <!-- reCAPTCHA -->
    <script>

            const forgotPasswordForm =
                document.getElementById("forgotPasswordForm");

            const forgotPasswordButton =
                document.getElementById("forgotPasswordSubmit");


            forgotPasswordForm.addEventListener("submit", function(event) {

                // If reCAPTCHA token already exists,
                // allow normal form submission
                const token =
                    document.getElementById("recaptchaToken").value;

                if (token) {
                    return;
                }


                // Stop form submission until token is generated
                event.preventDefault();


                // Prevent multiple clicks
                forgotPasswordButton.disabled = true;


                grecaptcha.ready(function() {

                    grecaptcha.execute(
                        '@recaptchaSiteKey',
                        {
                            action: 'forgot_password'
                        }
                    )
                        .then(function(token) {

                            document
                                .getElementById("recaptchaToken")
                                .value = token;


                            // Submit the form normally
                            forgotPasswordForm.submit();

                        })
                        .catch(function(error) {

                            console.error(error);

                            forgotPasswordButton.disabled = false;

                            alert(
                                "Security verification failed. Please try again."
                            );

                        });

                });

            });

    </script>

</body>

</html>