@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Access Denied - MaleFashion
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Boxicons -->
    <link rel="stylesheet"
          href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />

    <style>

            body {
                margin: 0;
                padding: 0;
                min-height: 100vh;

                display: flex;
                align-items: center;
                justify-content: center;

                background: #f5f5f5;

                font-family:
                    Arial,
                    Helvetica,
                    sans-serif;
            }


            .access-denied-container {

                width: 100%;
                max-width: 600px;

                padding: 20px;
            }


            .access-denied-card {

                background: #ffffff;

                padding: 50px 40px;

                text-align: center;

                border-radius: 6px;

                box-shadow:
                    0 5px 25px rgba(0, 0, 0, 0.08);
            }


            .access-icon {

                width: 90px;
                height: 90px;

                margin: 0 auto 25px;

                display: flex;
                align-items: center;
                justify-content: center;

                background: #111111;

                border-radius: 50%;
            }


            .access-icon i {

                font-size: 45px;

                color: #ffffff;
            }


            .access-denied-card h1 {

                margin-bottom: 15px;

                font-size: 32px;

                font-weight: 700;

                color: #111111;
            }


            .access-denied-card p {

                margin-bottom: 30px;

                font-size: 16px;

                line-height: 1.7;

                color: #777777;
            }


            .btn-signin {

                display: inline-flex;

                align-items: center;

                justify-content: center;

                gap: 8px;

                padding: 12px 28px;

                background: #111111;

                color: #ffffff;

                text-decoration: none;

                font-size: 14px;

                font-weight: 600;

                text-transform: uppercase;

                letter-spacing: 1px;

                border-radius: 3px;

                transition: all 0.3s ease;
            }


            .btn-signin:hover {

                background: #333333;

                color: #ffffff;

                transform: translateY(-2px);
            }


            .btn-home {

                display: inline-block;

                margin-top: 15px;

                color: #777777;

                text-decoration: none;

                font-size: 14px;
            }


            .btn-home:hover {

                color: #111111;
            }


            .brand-name {

                margin-top: 30px;

                font-size: 20px;

                font-weight: 700;

                letter-spacing: 2px;

                color: #111111;
            }

    </style>

</head>


<body>


    <div class="access-denied-container">

        <div class="access-denied-card">


            <!-- ICON -->

            <div class="access-icon">

                <i class="bx bx-lock-alt"></i>

            </div>


            <!-- TITLE -->

            <h1>
                Access Denied
            </h1>


            <!-- MESSAGE -->

            <p>
                You do not have permission to access this page.
                Please sign in with an authorized account to continue.
            </p>




            <!-- HOME -->

            <div>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index1"
                   class="btn-home">

                    ← Back to Home

                </a>

            </div>


            <!-- BRAND -->

            <div class="brand-name">

                MaleFashion

            </div>


        </div>

    </div>


</body>

</html>